<UserControl x:Class="NEXUS.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:NEXUS.Controls">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,0,20,24">
        <Grid Margin="0,0,8,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ================= LEFT COLUMN ================= -->
            <StackPanel Grid.Column="0" Margin="0,0,14,0">

                <!-- Appearance -->
                <Border Style="{StaticResource Panel}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionLabel}" ctrl:Tracking.Text="APPEARANCE" />

                        <TextBlock Text="Theme" Style="{StaticResource Caption}" Margin="0,16,0,0" />
                        <ItemsControl ItemsSource="{Binding Themes}" Margin="0,10,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="4" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <RadioButton GroupName="Theme" Cursor="Hand" Margin="0,0,8,0"
                                                 FocusVisualStyle="{x:Null}"
                                                 Command="{Binding DataContext.SetThemeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                 CommandParameter="{Binding Name}">
                                        <RadioButton.IsChecked>
                                            <MultiBinding Converter="{StaticResource MultiEq}" Mode="OneWay">
                                                <Binding Path="Name" />
                                                <Binding Path="DataContext.Theme"
                                                         RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                            </MultiBinding>
                                        </RadioButton.IsChecked>
                                        <RadioButton.Template>
                                            <ControlTemplate TargetType="RadioButton">
                                                <Border x:Name="Root" CornerRadius="8" Padding="10"
                                                        Background="{StaticResource BrushPanelAlt}"
                                                        BorderBrush="{StaticResource BrushBorderSoft}"
                                                        BorderThickness="1">
                                                    <StackPanel>
                                                        <Border Height="34" CornerRadius="5"
                                                                Background="{Binding Swatch}" />
                                                        <TextBlock Text="{Binding Name}" FontSize="10"
                                                                   Margin="0,8,0,0" HorizontalAlignment="Center"
                                                                   Foreground="{StaticResource BrushTextDim}" />
                                                    </StackPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Root" Property="BorderBrush"
                                                                Value="{StaticResource BrushAccentSoft}" />
                                                    </Trigger>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="Root" Property="BorderBrush"
                                                                Value="{StaticResource BrushAccent}" />
                                                        <Setter TargetName="Root" Property="Background"
                                                                Value="{StaticResource BrushAccentFaint}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </RadioButton.Template>
                                    </RadioButton>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="Accent colour" Style="{StaticResource Caption}" Margin="0,18,0,0" />
                        <ItemsControl ItemsSource="{Binding Accents}" Margin="0,10,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <RadioButton GroupName="Accent" Width="40" Height="40" Margin="0,0,10,0"
                                                 Cursor="Hand" FocusVisualStyle="{x:Null}" ToolTip="{Binding Name}"
                                                 Command="{Binding DataContext.SetAccentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                 CommandParameter="{Binding Name}">
                                        <RadioButton.IsChecked>
                                            <MultiBinding Converter="{StaticResource MultiEq}" Mode="OneWay">
                                                <Binding Path="Name" />
                                                <Binding Path="DataContext.Accent"
                                                         RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                            </MultiBinding>
                                        </RadioButton.IsChecked>
                                        <RadioButton.Template>
                                            <ControlTemplate TargetType="RadioButton">
                                                <Border x:Name="Root" CornerRadius="20" Padding="4"
                                                        BorderThickness="1"
                                                        BorderBrush="{StaticResource BrushBorderSoft}"
                                                        Background="{StaticResource BrushPanelAlt}">
                                                    <Ellipse Fill="{Binding Swatch}" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Root" Property="BorderBrush"
                                                                Value="{StaticResource BrushText}" />
                                                    </Trigger>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="Root" Property="BorderThickness" Value="2" />
                                                        <Setter TargetName="Root" Property="BorderBrush"
                                                                Value="{StaticResource BrushText}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </RadioButton.Template>
                                    </RadioButton>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Style="{StaticResource Muted}" FontSize="10.5" Margin="0,10,0,0">
                            <Run Text="Active: " /><Run Text="{Binding Theme, Mode=OneWay}" /><Run Text=" / " /><Run Text="{Binding Accent, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Notifications -->
                <Border Style="{StaticResource Panel}" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionLabel}" ctrl:Tracking.Text="NOTIFICATIONS" />

                        <Grid Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Text="Session notifications" Style="{StaticResource Caption}" />
                                <TextBlock Text="Alert when a focus session finishes." Style="{StaticResource Muted}"
                                           FontSize="10.5" Margin="0,3,0,0" />
                            </StackPanel>
                            <CheckBox Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                      VerticalAlignment="Center" IsChecked="{Binding NotificationsEnabled}" />
                        </Grid>

                        <Grid Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Text="On-screen toasts" Style="{StaticResource Caption}" />
                                <TextBlock Text="Show transient confirmations in the corner."
                                           Style="{StaticResource Muted}" FontSize="10.5" Margin="0,3,0,0" />
                            </StackPanel>
                            <CheckBox Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                      VerticalAlignment="Center" IsChecked="{Binding ToastsEnabled}" />
                        </Grid>

                        <Grid Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Text="Sound" Style="{StaticResource Caption}" />
                                <TextBlock Text="Play a system chime on completion and timer end."
                                           Style="{StaticResource Muted}" FontSize="10.5" Margin="0,3,0,0" />
                            </StackPanel>
                            <CheckBox Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                      VerticalAlignment="Center" IsChecked="{Binding SoundEnabled}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Behaviour -->
                <Border Style="{StaticResource Panel}" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionLabel}" ctrl:Tracking.Text="BEHAVIOUR" />

                        <TextBlock Text="Default focus duration" Style="{StaticResource Caption}" Margin="0,16,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <ToggleButton Style="{StaticResource Chip}" Content="15 MIN"
                                          IsChecked="{Binding DefaultFocusKey, Converter={StaticResource EqBool}, ConverterParameter=15, Mode=OneWay}"
                                          Command="{Binding SetFocusDurationCommand}" CommandParameter="15" />
                            <ToggleButton Style="{StaticResource Chip}" Content="25 MIN"
                                          IsChecked="{Binding DefaultFocusKey, Converter={StaticResource EqBool}, ConverterParameter=25, Mode=OneWay}"
                                          Command="{Binding SetFocusDurationCommand}" CommandParameter="25" />
                            <ToggleButton Style="{StaticResource Chip}" Content="45 MIN"
                                          IsChecked="{Binding DefaultFocusKey, Converter={StaticResource EqBool}, ConverterParameter=45, Mode=OneWay}"
                                          Command="{Binding SetFocusDurationCommand}" CommandParameter="45" />
                            <ToggleButton Style="{StaticResource Chip}" Content="60 MIN"
                                          IsChecked="{Binding DefaultFocusKey, Converter={StaticResource EqBool}, ConverterParameter=60, Mode=OneWay}"
                                          Command="{Binding SetFocusDurationCommand}" CommandParameter="60" />
                        </StackPanel>

                        <Border Style="{StaticResource Divider}" Margin="0,18,0,4" />

                        <Grid Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="Start with Windows" Style="{StaticResource Caption}" />
                                <TextBlock Text="Registers NEXUS in the current user's start-up entries."
                                           Style="{StaticResource Muted}" FontSize="10.5" Margin="0,3,0,0" />
                            </StackPanel>
                            <CheckBox Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                      VerticalAlignment="Center" IsChecked="{Binding LaunchOnStartup}" />
                        </Grid>

                        <Grid Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Text="Restore last section" Style="{StaticResource Caption}" />
                                <TextBlock Text="Reopen on the screen you were last using."
                                           Style="{StaticResource Muted}" FontSize="10.5" Margin="0,3,0,0" />
                            </StackPanel>
                            <CheckBox Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                      VerticalAlignment="Center" IsChecked="{Binding RestoreLastSection}" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ================= RIGHT COLUMN ================= -->
            <StackPanel Grid.Column="1">

                <!-- Deadline -->
                <Border Style="{StaticResource Panel}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionLabel}" ctrl:Tracking.Text="MISSION DEADLINE" />

                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="110" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="Date (YYYY-MM-DD)" Style="{StaticResource Muted}" FontSize="10" />
                                <TextBox Style="{StaticResource Input}" Margin="0,6,0,0"
                                         Text="{Binding DeadlineDate, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Time (HH:MM)" Style="{StaticResource Muted}" FontSize="10" />
                                <TextBox Style="{StaticResource Input}" Margin="0,6,0,0"
                                         Text="{Binding DeadlineTime, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Style="{StaticResource BtnPrimary}" Content="APPLY" Padding="18,8"
                                    Command="{Binding ApplyDeadlineCommand}" />
                            <Button Style="{StaticResource BtnGhost}" Content="NEXT WEDNESDAY" Padding="14,8"
                                    Margin="10,0,0,0" Command="{Binding NextWednesdayCommand}" />
                        </StackPanel>

                        <Grid Margin="0,18,0,0">
                            <StackPanel>
                                <TextBlock Text="Auto-roll a passed deadline" Style="{StaticResource Caption}" />
                                <TextBlock Text="Move the deadline to the next Wednesday on launch."
                                           Style="{StaticResource Muted}" FontSize="10.5" Margin="0,3,0,0" />
                            </StackPanel>
                            <CheckBox Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                      VerticalAlignment="Center" IsChecked="{Binding AutoRollDeadline}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Data -->
                <Border Style="{StaticResource Panel}" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionLabel}" ctrl:Tracking.Text="DATA" />

                        <TextBlock Text="All tasks, activity and settings are stored locally as JSON and saved automatically."
                                   Style="{StaticResource Muted}" FontSize="10.5" TextWrapping="Wrap"
                                   Margin="0,14,0,0" />

                        <Border Style="{StaticResource InsetPanel}" Margin="0,12,0,0" Padding="12,10">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionLabel}" ctrl:Tracking.Text="STORAGE LOCATION" />
                                <TextBlock Text="{Binding StoragePath}" Style="{StaticResource Mono}"
                                           FontSize="10.5" TextWrapping="Wrap" Margin="0,6,0,0"
                                           Foreground="{StaticResource BrushTextDim}" />
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Button Style="{StaticResource Btn}" Content="EXPORT" Padding="18,8"
                                    Command="{Binding ExportCommand}" />
                            <Button Style="{StaticResource Btn}" Content="IMPORT" Padding="18,8" Margin="10,0,0,0"
                                    Command="{Binding ImportCommand}" />
                            <Button Style="{StaticResource BtnGhost}" Content="OPEN FOLDER" Padding="14,8"
                                    Margin="10,0,0,0" Command="{Binding OpenFolderCommand}" />
                        </StackPanel>

                        <Border Style="{StaticResource Divider}" Margin="0,18,0,14" />

                        <Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Reset all data" Style="{StaticResource Caption}" />
                                <TextBlock Text="Erases every task, session and log entry."
                                           Style="{StaticResource Muted}" FontSize="10.5" Margin="0,3,0,0" />
                            </StackPanel>
                            <Button Style="{StaticResource BtnDanger}" Content="ERASE" Padding="18,8"
                                    HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Command="{Binding ResetCommand}" />
                        </Grid>

                        <TextBlock Text="{Binding Status}" Style="{StaticResource Muted}" FontSize="10.5"
                                   TextWrapping="Wrap" Margin="0,14,0,0"
                                   Visibility="{Binding Status, Converter={StaticResource StrToVis}}" />
                    </StackPanel>
                </Border>

                <!-- About -->
                <Border Style="{StaticResource Panel}" Margin="0,14,0,0">
                    <Grid>
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionLabel}" ctrl:Tracking.Text="ABOUT" />
                            <TextBlock Text="NEXUS — Personal Command Center" FontSize="12.5" FontWeight="SemiBold"
                                       Margin="0,10,0,0" />
                            <TextBlock Style="{StaticResource Muted}" FontSize="10.5" Margin="0,4,0,0">
                                <Run Text="Version " /><Run Text="{Binding Version, Mode=OneWay}" /><Run Text=" · .NET 8 · WPF" />
                            </TextBlock>
                        </StackPanel>
                        <Border Width="34" Height="34" CornerRadius="8" HorizontalAlignment="Right"
                                VerticalAlignment="Center" Background="{StaticResource BrushAccentGradient}" />
                    </Grid>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
