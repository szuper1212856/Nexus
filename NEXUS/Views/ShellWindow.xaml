<Window x:Class="NEXUS.Views.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:ctrl="clr-namespace:NEXUS.Controls"
        Title="NEXUS — Personal Command Center"
        Width="1420" Height="920" MinWidth="1080" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="{StaticResource BrushBg0}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6"
                            CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.InputBindings>
        <KeyBinding Modifiers="Control" Key="N" Command="{Binding NewTaskCommand}" />
        <KeyBinding Modifiers="Control" Key="F" Command="{Binding StartFocusCommand}" />
        <KeyBinding Modifiers="Control" Key="D1" Command="{Binding NavigateCommand}" CommandParameter="OVERVIEW" />
        <KeyBinding Modifiers="Control" Key="D2" Command="{Binding NavigateCommand}" CommandParameter="TASKS" />
        <KeyBinding Modifiers="Control" Key="D3" Command="{Binding NavigateCommand}" CommandParameter="QUICK" />
        <KeyBinding Modifiers="Control" Key="D4" Command="{Binding NavigateCommand}" CommandParameter="FOCUS" />
        <KeyBinding Modifiers="Control" Key="D5" Command="{Binding NavigateCommand}" CommandParameter="ANALYTICS" />
        <KeyBinding Modifiers="Control" Key="D6" Command="{Binding NavigateCommand}" CommandParameter="ACTIVITY" />
        <KeyBinding Modifiers="Control" Key="D7" Command="{Binding NavigateCommand}" CommandParameter="SETTINGS" />
    </Window.InputBindings>

    <Border x:Name="RootBorder" Background="{StaticResource BrushWindow}"
            BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ================= TITLE BAR ================= -->
            <Grid Grid.Row="0" x:Name="TitleBar" Background="Transparent"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                    <Border Width="16" Height="16" CornerRadius="4" Background="{StaticResource BrushAccentGradient}" />
                    <TextBlock Text="NEXUS" FontWeight="Bold" FontSize="12" Margin="10,0,0,0"
                               VerticalAlignment="Center" />
                    <Border Width="1" Height="12" Background="{StaticResource BrushBorder}" Margin="10,0" />
                    <TextBlock Style="{StaticResource Muted}" FontSize="10.5" VerticalAlignment="Center"
                               ctrl:Tracking.Text="PERSONAL COMMAND CENTER" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <Ellipse x:Name="StatusDot" Width="6" Height="6" Fill="{StaticResource BrushCompleted}"
                             VerticalAlignment="Center">
                        <Ellipse.Triggers>
                            <EventTrigger RoutedEvent="Ellipse.Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                         From="1" To="0.28" Duration="0:0:1.6" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Ellipse.Triggers>
                    </Ellipse>
                    <TextBlock Text="{Binding SystemStatus}" Style="{StaticResource Muted}" FontSize="10"
                               Margin="8,0,0,0" VerticalAlignment="Center" />
                    <Border Width="1" Height="12" Background="{StaticResource BrushBorder}" Margin="12,0" />
                    <TextBlock Style="{StaticResource Mono}" FontSize="11" Foreground="{StaticResource BrushTextDim}"
                               VerticalAlignment="Center">
                        <Run Text="{Binding TimeDisplay, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Style="{StaticResource BtnCaption}" Content="&#xE921;" Click="Minimize_Click"
                            ToolTip="Minimize" />
                    <Button Style="{StaticResource BtnCaption}" x:Name="MaxButton" Content="&#xE922;"
                            Click="Maximize_Click" ToolTip="Maximize" />
                    <Button Style="{StaticResource BtnClose}" Content="&#xE8BB;" Click="Close_Click"
                            ToolTip="Close" />
                </StackPanel>
            </Grid>

            <!-- ================= BODY ================= -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="228" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Sidebar -->
                <Border Grid.Column="0" Background="{StaticResource BrushPanelAlt}"
                        BorderBrush="{StaticResource BrushBorderSoft}" BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="20,20,20,14">
                            <TextBlock Style="{StaticResource SectionLabel}" ctrl:Tracking.Text="MISSION" />
                            <TextBlock Text="{Binding HeaderPercent, StringFormat={}{0}%}"
                                       Style="{StaticResource MetricValue}" FontSize="30" Margin="0,6,0,0" />
                            <Grid Margin="0,10,0,0" Height="4">
                                <Border Style="{StaticResource SlimBar}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{Binding Overview.CompletionFraction, Converter={StaticResource FracStar}}" />
                                        <ColumnDefinition Width="{Binding Overview.CompletionFraction, Converter={StaticResource FracStarRem}}" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Height="4" CornerRadius="2"
                                            Background="{StaticResource BrushAccentGradient}" />
                                </Grid>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <TextBlock Style="{StaticResource Muted}" FontSize="10">
                                    <Run Text="{Binding HeaderCompleted, Mode=OneWay}" /><Run Text=" DONE" />
                                </TextBlock>
                                <TextBlock Style="{StaticResource Muted}" FontSize="10" Margin="10,0,0,0">
                                    <Run Text="{Binding HeaderRemaining, Mode=OneWay}" /><Run Text=" LEFT" />
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>

                        <ItemsControl Grid.Row="1" ItemsSource="{Binding Sections}" Margin="0,6,0,0"
                                      Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <RadioButton Style="{StaticResource NavItem}"
                                                 GroupName="Nav"
                                                 Content="{Binding Label}"
                                                 Tag="{Binding Glyph}"
                                                 IsChecked="{Binding IsSelected, Mode=OneWay}"
                                                 Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                 CommandParameter="{Binding Key}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Deadline summary pinned to the bottom of the rail -->
                        <Border Grid.Row="2" Margin="14,10,14,14" Padding="14,12"
                                Background="{StaticResource BrushPanel}"
                                BorderBrush="{StaticResource BrushBorderSoft}" BorderThickness="1"
                                CornerRadius="8">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionLabel}" ctrl:Tracking.Text="DEADLINE" />
                                <TextBlock Text="{Binding DeadlineDayName}" FontWeight="SemiBold" FontSize="13"
                                           Margin="0,6,0,0" />
                                <TextBlock Text="{Binding CompactCountdown}" Style="{StaticResource Mono}"
                                           FontSize="12" Margin="0,4,0,0"
                                           Foreground="{Binding DeadlineBrushKey, Converter={StaticResource ResBrush}}" />
                                <TextBlock Text="{Binding DeadlineDateText}" Style="{StaticResource Muted}"
                                           FontSize="10" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Content column -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Page header -->
                    <Grid Grid.Row="0" Margin="28,22,28,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding CurrentTitle}" Style="{StaticResource PageTitle}" />
                            <TextBlock Text="{Binding CurrentSubtitle}" Style="{StaticResource Muted}"
                                       Margin="0,3,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Style="{StaticResource InsetPanel}" Padding="14,8" Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Mono}" FontSize="15" FontWeight="SemiBold"
                                               Text="{Binding TimeDisplay}" VerticalAlignment="Center" />
                                    <TextBlock Style="{StaticResource Mono}" FontSize="10"
                                               Foreground="{StaticResource BrushTextMuted}" Margin="2,0,0,0"
                                               VerticalAlignment="Bottom" Text="{Binding SecondsDisplay}" />
                                    <Border Width="1" Background="{StaticResource BrushBorder}" Margin="12,2" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DayDisplay}" Style="{StaticResource Muted}" FontSize="9.5" />
                                        <TextBlock Text="{Binding DateDisplay}" Style="{StaticResource Caption}" FontSize="11" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Button Style="{StaticResource BtnPrimary}" Command="{Binding NewTaskCommand}"
                                    ToolTip="Create a new task (Ctrl+N)">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE710;" FontFamily="{StaticResource FontIcon}" FontSize="11"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="NEW TASK" Margin="8,0,0,0" FontSize="11" FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Active section -->
                    <ContentControl x:Name="SectionHost" Grid.Row="1" Content="{Binding CurrentViewModel}"
                                    Margin="0,0,0,0" RenderTransformOrigin="0.5,0.5">
                        <ContentControl.RenderTransform>
                            <TranslateTransform x:Name="SectionShift" Y="0" />
                        </ContentControl.RenderTransform>
                    </ContentControl>
                </Grid>
            </Grid>

            <!-- ================= TOASTS ================= -->
            <ItemsControl Grid.Row="1" ItemsSource="{Binding Toasts}"
                          HorizontalAlignment="Right" VerticalAlignment="Bottom"
                          Margin="0,0,26,26" Width="330" IsHitTestVisible="True">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,8,0,0" Padding="14,12" CornerRadius="8"
                                Background="{StaticResource BrushPanel}"
                                BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.55" Color="#000000" />
                            </Border.Effect>
                            <Border.Triggers>
                                <EventTrigger RoutedEvent="Border.Loaded">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                             From="0" To="1" Duration="0:0:0.22" />
                                            <DoubleAnimation
                                                Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                From="24" To="0" Duration="0:0:0.28">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Border.Triggers>
                            <Border.RenderTransform>
                                <TranslateTransform X="0" />
                            </Border.RenderTransform>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="3" CornerRadius="2" Margin="0,0,12,0"
                                        Background="{Binding Kind, Converter={StaticResource ToastBrush}}" />

                                <StackPanel Grid.Column="1">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource FontIcon}"
                                                   FontSize="11" VerticalAlignment="Center"
                                                   Foreground="{Binding Kind, Converter={StaticResource ToastBrush}}" />
                                        <TextBlock Text="{Binding Title}" FontSize="11" FontWeight="SemiBold"
                                                   Margin="8,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding Message}" Style="{StaticResource Muted}"
                                               TextWrapping="Wrap" Margin="0,5,0,0"
                                               Visibility="{Binding Message, Converter={StaticResource StrToVis}}" />
                                </StackPanel>

                                <Button Grid.Column="2" Style="{StaticResource BtnIcon}" Width="22" Height="22"
                                        Content="&#xE8BB;" FontSize="8" VerticalAlignment="Top"
                                        Command="{Binding DataContext.DismissToastCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </Border>
</Window>
