<UserControl x:Class="NEXUS.Views.AnalyticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:NEXUS.Controls">

    <UserControl.Resources>
        <!-- Horizontal bar used by the priority and status charts -->
        <DataTemplate x:Key="HBar">
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="94" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="34" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding Label}" Style="{StaticResource Muted}"
                           FontSize="10" VerticalAlignment="Center" />

                <Grid Grid.Column="1" Height="10" VerticalAlignment="Center">
                    <Border CornerRadius="5" Background="{StaticResource BrushBorderSoft}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{Binding Fraction, Converter={StaticResource FracStar}}" />
                            <ColumnDefinition Width="{Binding Fraction, Converter={StaticResource FracStarRem}}" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" CornerRadius="5"
                                Background="{Binding BrushKey, Converter={StaticResource ResBrush}}" />
                    </Grid>
                </Grid>

                <TextBlock Grid.Column="2" Text="{Binding Count}" Style="{StaticResource Mono}"
                           FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,0,20,24">
        <StackPanel Margin="0,0,8,0">

            <!-- ================= HEADLINE METRICS ================= -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Panel}" Margin="0,0,14,0">
                    <Grid Width="124" Height="124">
                        <ctrl:RingGauge Value="{Binding CompletionFraction}" RingThickness="10"
                                        TrackBrush="{StaticResource BrushBorderSoft}"
                                        ValueBrush="{StaticResource BrushAccent}" />
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="{Binding CompletionPercent, StringFormat={}{0}%}"
                                       Style="{StaticResource Mono}" FontSize="26" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" />
                            <TextBlock Style="{StaticResource Muted}" FontSize="9" HorizontalAlignment="Center"
                                       ctrl:Tracking.Text="COMPLETE" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource Panel}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionLabel}" ctrl:Tracking.Text="MISSION METRICS" />
                        <UniformGrid Columns="4" Margin="0,18,0,0">
                            <StackPanel>
                                <TextBlock Text="{Binding Completed}" Style="{StaticResource MetricValue}"
                                           Foreground="{StaticResource BrushCompleted}" />
                                <TextBlock Style="{StaticResource MetricLabel}" ctrl:Tracking.Text="COMPLETED" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="{Binding Remaining}" Style="{StaticResource MetricValue}"
                                           Foreground="{StaticResource BrushHigh}" />
                                <TextBlock Style="{StaticResource MetricLabel}" ctrl:Tracking.Text="REMAINING" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="{Binding Overdue}" Style="{StaticResource MetricValue}"
                                           Foreground="{StaticResource BrushCritical}" />
                                <TextBlock Style="{StaticResource MetricLabel}" ctrl:Tracking.Text="OVERDUE" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="{Binding Total}" Style="{StaticResource MetricValue}" />
                                <TextBlock Style="{StaticResource MetricLabel}" ctrl:Tracking.Text="TOTAL" />
                            </StackPanel>
                        </UniformGrid>

                        <Border Style="{StaticResource Divider}" Margin="0,18,0,14" />

                        <UniformGrid Columns="4">
                            <StackPanel>
                                <TextBlock Text="{Binding AverageCompletionTime}" Style="{StaticResource Mono}"
                                           FontSize="14" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource MetricLabel}" ctrl:Tracking.Text="AVG COMPLETION" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="{Binding Throughput}" Style="{StaticResource Mono}"
                                           FontSize="14" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource MetricLabel}" ctrl:Tracking.Text="THROUGHPUT" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="{Binding TotalFocusTime}" Style="{StaticResource Mono}"
                                           FontSize="14" FontWeight="SemiBold"
                                           Foreground="{StaticResource BrushAccent}" />
                                <TextBlock Style="{StaticResource MetricLabel}" ctrl:Tracking.Text="FOCUS TIME" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="{Binding BestDay}" Style="{StaticResource Mono}"
                                           FontSize="14" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource MetricLabel}" ctrl:Tracking.Text="BEST DAY" />
                            </StackPanel>
                        </UniformGrid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ================= DISTRIBUTIONS ================= -->
            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Panel}" Margin="0,0,14,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionLabel}" ctrl:Tracking.Text="TASKS BY PRIORITY" />
                        <ItemsControl ItemsSource="{Binding PriorityBars}" Margin="0,18,0,0"
                                      ItemTemplate="{StaticResource HBar}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource Panel}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionLabel}" ctrl:Tracking.Text="TASKS BY STATUS" />
                        <ItemsControl ItemsSource="{Binding StatusBars}" Margin="0,18,0,0"
                                      ItemTemplate="{StaticResource HBar}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ================= COMPLETION HISTORY ================= -->
            <Border Style="{StaticResource Panel}" Margin="0,14,0,0">
                <StackPanel>
                    <Grid>
                        <TextBlock Style="{StaticResource SectionLabel}" ctrl:Tracking.Text="COMPLETION HISTORY" />
                        <TextBlock Text="LAST 7 DAYS" Style="{StaticResource Muted}" FontSize="10"
                                   HorizontalAlignment="Right" />
                    </Grid>

                    <ItemsControl ItemsSource="{Binding HistoryBars}" Margin="0,20,0,0" Height="168">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="6,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Text="{Binding Count}" Style="{StaticResource Mono}"
                                               FontSize="11" HorizontalAlignment="Center" Margin="0,0,0,6" />

                                    <Grid Grid.Row="1" VerticalAlignment="Bottom">
                                        <Border CornerRadius="5" VerticalAlignment="Bottom"
                                                Height="{Binding Fraction, Converter={StaticResource FracHeight}, ConverterParameter=112}"
                                                Background="{Binding BrushKey, Converter={StaticResource ResBrush}}"
                                                Opacity="0.85" />
                                    </Grid>

                                    <StackPanel Grid.Row="2" Margin="0,8,0,0">
                                        <TextBlock x:Name="DayLabel" Text="{Binding Label}"
                                                   Style="{StaticResource Muted}" FontSize="10"
                                                   HorizontalAlignment="Center" />
                                        <TextBlock Text="{Binding Sub}" Style="{StaticResource Mono}" FontSize="9"
                                                   HorizontalAlignment="Center"
                                                   Foreground="{StaticResource BrushTextMuted}" />
                                    </StackPanel>
                                </Grid>

                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                                        <Setter TargetName="DayLabel" Property="Foreground"
                                                Value="{StaticResource BrushAccent}" />
                                        <Setter TargetName="DayLabel" Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="Completion history fills in as tasks are cleared. Two or more completed tasks are needed before an average completion time can be calculated."
                               Style="{StaticResource Muted}" FontSize="10.5" TextWrapping="Wrap"
                               Margin="0,16,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
