<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!--
        Brushes are intentionally NOT frozen: ThemeService mutates their Color at runtime,
        which lets every StaticResource reference re-render instantly when the theme changes.
    -->

    <!-- Surfaces -->
    <SolidColorBrush x:Key="BrushBg0" Color="#05070B" />
    <SolidColorBrush x:Key="BrushBg1" Color="#0A0E15" />
    <SolidColorBrush x:Key="BrushPanel" Color="#111823" />
    <SolidColorBrush x:Key="BrushPanelAlt" Color="#0D131C" />
    <SolidColorBrush x:Key="BrushBorder" Color="#1D2836" />
    <SolidColorBrush x:Key="BrushBorderSoft" Color="#161F2B" />

    <!-- Text -->
    <SolidColorBrush x:Key="BrushText" Color="#E8EFF9" />
    <SolidColorBrush x:Key="BrushTextDim" Color="#95A7BF" />
    <SolidColorBrush x:Key="BrushTextMuted" Color="#5C7089" />

    <!-- Accent -->
    <SolidColorBrush x:Key="BrushAccent" Color="#22D3EE" />
    <SolidColorBrush x:Key="BrushAccentSoft" Color="#3322D3EE" />
    <SolidColorBrush x:Key="BrushAccentFaint" Color="#1A22D3EE" />

    <!-- Signal colours -->
    <SolidColorBrush x:Key="BrushCritical" Color="#FF5470" />
    <SolidColorBrush x:Key="BrushHigh" Color="#FF9F45" />
    <SolidColorBrush x:Key="BrushNormal" Color="#FFD34E" />
    <SolidColorBrush x:Key="BrushLow" Color="#4DA3FF" />
    <SolidColorBrush x:Key="BrushPlanned" Color="#7C8DA6" />
    <SolidColorBrush x:Key="BrushCompleted" Color="#34D399" />
    <SolidColorBrush x:Key="BrushTransparent" Color="#00000000" />
    <SolidColorBrush x:Key="BrushOverlay" Color="#B3040609" />
    <SolidColorBrush x:Key="BrushHover" Color="#12FFFFFF" />
    <SolidColorBrush x:Key="BrushPressed" Color="#08000000" />

    <!-- Gradients (stops mutated by ThemeService) -->
    <LinearGradientBrush x:Key="BrushWindow" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#05070B" />
        <GradientStop Offset="0.55" Color="#0A0E15" />
        <GradientStop Offset="1" Color="#080D16" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BrushPanelGradient" StartPoint="0,0" EndPoint="0.4,1">
        <GradientStop Offset="0" Color="#E6111823" />
        <GradientStop Offset="1" Color="#CC0D131C" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BrushAccentGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#22D3EE" />
        <GradientStop Offset="1" Color="#5BDFF3" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BrushAccentGlow" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#4022D3EE" />
        <GradientStop Offset="1" Color="#0022D3EE" />
    </LinearGradientBrush>

    <!-- Typography -->
    <FontFamily x:Key="FontUI">Segoe UI Variable Display, Segoe UI, Inter, Arial</FontFamily>
    <FontFamily x:Key="FontMono">Cascadia Mono, Consolas, Segoe UI Mono, Courier New</FontFamily>
    <FontFamily x:Key="FontIcon">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <sys:Double x:Key="SizeDisplay">44</sys:Double>
    <sys:Double x:Key="SizeH1">22</sys:Double>
    <sys:Double x:Key="SizeH2">15</sys:Double>
    <sys:Double x:Key="SizeBody">13</sys:Double>
    <sys:Double x:Key="SizeSmall">11.5</sys:Double>
    <sys:Double x:Key="SizeMicro">10</sys:Double>

    <CornerRadius x:Key="RadiusPanel">10</CornerRadius>
    <CornerRadius x:Key="RadiusControl">6</CornerRadius>
    <CornerRadius x:Key="RadiusPill">20</CornerRadius>

    <Duration x:Key="DurFast">0:0:0.15</Duration>
    <Duration x:Key="DurMed">0:0:0.28</Duration>

</ResourceDictionary>
