<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:NEXUS.Converters">

    <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
    <conv:BoolToVisibilityConverter x:Key="BoolToVisInv" Invert="True" />
    <conv:InverseBoolConverter x:Key="NotBool" />
    <conv:StringToVisibilityConverter x:Key="StrToVis" />
    <conv:StringToVisibilityConverter x:Key="StrToVisInv" Invert="True" />
    <conv:CountToVisibilityConverter x:Key="CountToVis" />
    <conv:CountToVisibilityConverter x:Key="CountToVisInv" Invert="True" />
    <conv:PriorityBrushConverter x:Key="PriorityBrush" />
    <conv:StateBrushConverter x:Key="StateBrush" />
    <conv:ActivityBrushConverter x:Key="ActivityBrush" />
    <conv:ToastBrushConverter x:Key="ToastBrush" />
    <conv:ResourceKeyToBrushConverter x:Key="ResBrush" />
    <conv:FractionToStarConverter x:Key="FracStar" />
    <conv:FractionToStarConverter x:Key="FracStarRem" Remainder="True" />
    <conv:FractionToHeightConverter x:Key="FracHeight" />
    <conv:EqualityToBoolConverter x:Key="EqBool" />
    <conv:EqualityToVisibilityConverter x:Key="EqVis" />
    <conv:MultiplyConverter x:Key="Multiply" />
    <conv:FractionToPercentTextConverter x:Key="FracPercent" />
    <conv:BoolToOpacityConverter x:Key="DoneOpacity" />
    <conv:MultiEqualityConverter x:Key="MultiEq" />

</ResourceDictionary>
