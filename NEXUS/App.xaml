<Application x:Class="NEXUS.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:NEXUS.ViewModels"
             xmlns:views="clr-namespace:NEXUS.Views"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <!-- Order matters: later dictionaries reference resources from earlier ones. -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Theme.xaml" />
                <ResourceDictionary Source="Resources/Converters.xaml" />
                <ResourceDictionary Source="Resources/Styles.xaml" />
                <ResourceDictionary Source="Resources/TaskCard.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Section view-model to view mapping -->
            <DataTemplate DataType="{x:Type vm:OverviewViewModel}">
                <views:OverviewView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:TasksViewModel}">
                <views:TasksView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:QuickActionsViewModel}">
                <views:QuickActionsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:FocusViewModel}">
                <views:FocusView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:AnalyticsViewModel}">
                <views:AnalyticsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ActivityViewModel}">
                <views:ActivityView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
                <views:SettingsView />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
