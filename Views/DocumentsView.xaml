<UserControl x:Class="NEXUS.Views.DocumentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:NEXUS.Controls">

    <Grid Margin="28,0,20,24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="*" MinWidth="440" />
        </Grid.ColumnDefinitions>

        <!-- ================= SHELVES + LIST ================= -->
        <Grid Grid.Column="0" Margin="0,0,14,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource Panel}">
                <StackPanel>
                    <Grid>
                        <TextBlock Style="{StaticResource SectionLabel}" ctrl:Tracking.Text="DOCUMENT SHELVES" />
                        <TextBlock Text="{Binding DocumentCount}" Style="{StaticResource CellMono}"
                                   HorizontalAlignment="Right" />
                    </Grid>

                    <ItemsControl ItemsSource="{Binding Shelves}" Margin="0,12,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <RadioButton GroupName="DocShelf" Style="{StaticResource RowButton}"
                                             Command="{Binding DataContext.SetShelfCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                             CommandParameter="{Binding}">
                                    <RadioButton.IsChecked>
                                        <MultiBinding Converter="{StaticResource MultiEq}" Mode="OneWay">
                                            <Binding />
                                            <Binding Path="DataContext.Shelf"
                                                     RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                        </MultiBinding>
                                    </RadioButton.IsChecked>

                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{ctrl:Glyph Document}" FontFamily="{StaticResource FontIcon}"
                                                   FontSize="11" VerticalAlignment="Center" Margin="0,0,11,0"
                                                   Foreground="{StaticResource BrushTextDim}" />
                                        <TextBlock Text="{Binding}" Style="{StaticResource Cell}" FontSize="11.5" />
                                    </StackPanel>
                                </RadioButton>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource Panel}" Margin="0,14,0,0" Padding="14,14,8,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,6,10">
                        <TextBlock Style="{StaticResource SectionLabel}" ctrl:Tracking.Text="DOCUMENTS" />
                        <Button HorizontalAlignment="Right" Style="{StaticResource BtnSmall}" Content="NEW"
                                Command="{Binding NewCommand}" />
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <ItemsControl ItemsSource="{Binding Documents}" Margin="0,0,6,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <RadioButton GroupName="DocRow" Style="{StaticResource RowButton}"
                                                     Command="{Binding DataContext.SelectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                     CommandParameter="{Binding}">
                                            <RadioButton.IsChecked>
                                                <MultiBinding Converter="{StaticResource SameObj}" Mode="OneWay">
                                                    <Binding />
                                                    <Binding Path="DataContext.Selected"
                                                             RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                                </MultiBinding>
                                            </RadioButton.IsChecked>

                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{ctrl:Glyph Document}"
                                                               FontFamily="{StaticResource FontIcon}" FontSize="12"
                                                               VerticalAlignment="Center" Margin="0,0,10,0"
                                                               Foreground="{StaticResource BrushAccent}" />
                                                    <TextBlock Text="{Binding Name}" Style="{StaticResource Cell}"
                                                               FontWeight="SemiBold" MaxWidth="190"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <TextBlock Style="{StaticResource CellDim}" Margin="22,4,0,0">
                                                    <Run Text="{Binding WordCount, Mode=OneWay}" /><Run Text=" WORDS &#183; " /><Run Text="{Binding ModifiedDisplay, Mode=OneWay}" />
                                                </TextBlock>
                                            </StackPanel>
                                        </RadioButton>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="This shelf is empty." Style="{StaticResource Muted}" FontSize="10.5"
                                       Margin="12,14,0,0"
                                       Visibility="{Binding Documents.Count, Converter={StaticResource CountToVisInv}}" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource Panel}" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionLabel}" ctrl:Tracking.Text="START FROM A TEMPLATE" />
                    <ItemsControl ItemsSource="{Binding Templates}" Margin="0,10,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource RowItem}" Padding="10,7" Margin="0,0,0,2"
                                        Command="{Binding DataContext.FromTemplateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{ctrl:Glyph Add}" FontFamily="{StaticResource FontIcon}"
                                                   FontSize="10" VerticalAlignment="Center" Margin="0,0,10,0"
                                                   Foreground="{StaticResource BrushTextMuted}" />
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource Cell}" FontSize="11" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ================= EDITOR ================= -->
        <Border Grid.Column="1" Style="{StaticResource Panel}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Header -->
                <Border Grid.Row="0" Padding="20,14" BorderThickness="0,0,0,1"
                        BorderBrush="{StaticResource BrushBorderSoft}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,14,0"
                                    Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                            <TextBox Style="{StaticResource Input}" Padding="0" Background="Transparent"
                                     BorderThickness="0" FontSize="16" FontWeight="SemiBold"
                                     Text="{Binding TitleBuffer, UpdateSourceTrigger=PropertyChanged}" />
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Ellipse Width="7" Height="7" VerticalAlignment="Center"
                                         Fill="{Binding StateBrushKey, Converter={StaticResource ResBrush}}" />
                                <TextBlock Text="{Binding StateLabel}" FontSize="9" FontWeight="SemiBold"
                                           Margin="8,0,0,0" VerticalAlignment="Center"
                                           Foreground="{Binding StateBrushKey, Converter={StaticResource ResBrush}}" />
                                <TextBlock Text="{Binding StatsLine}" Style="{StaticResource CellDim}"
                                           Margin="14,0,0,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding LocationLabel}" Style="{StaticResource CellDim}"
                                           Margin="14,0,0,0" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" MaxWidth="240" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                    Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                            <Button Style="{StaticResource BtnPrimary}" Padding="14,8" Command="{Binding SaveCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{ctrl:Glyph Save}" FontFamily="{StaticResource FontIcon}"
                                               FontSize="11" VerticalAlignment="Center" />
                                    <TextBlock Text="SAVE" Margin="8,0,0,0" FontSize="10" FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource BtnSmallGhost}" Content="DUPLICATE" Margin="8,0,0,0"
                                    Command="{Binding DuplicateCommand}" />
                            <Button Style="{StaticResource BtnSmallGhost}" Content="RESTORE" Margin="8,0,0,0"
                                    Command="{Binding RestoreCommand}" />
                            <Button Style="{StaticResource BtnSmallGhost}" Content="TRASH" Margin="8,0,0,0"
                                    Command="{Binding DeleteCommand}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Editing surface -->
                <Grid Grid.Row="1">
                    <TextBox Padding="26,20" Background="Transparent" BorderThickness="0"
                             AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             VerticalContentAlignment="Top"
                             FontFamily="{StaticResource FontMono}" FontSize="12.5"
                             CaretBrush="{StaticResource BrushAccent}"
                             Foreground="{StaticResource BrushText}"
                             Text="{Binding EditorBody, UpdateSourceTrigger=PropertyChanged}"
                             Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}" />

                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisInv}}">
                        <TextBlock Text="{ctrl:Glyph Documents}" FontFamily="{StaticResource FontIcon}"
                                   FontSize="30" HorizontalAlignment="Center"
                                   Foreground="{StaticResource BrushTextMuted}" />
                        <TextBlock Text="NO DOCUMENT OPEN" Style="{StaticResource SectionLabel}"
                                   HorizontalAlignment="Center" Margin="0,16,0,0" />
                        <TextBlock Text="Select a document, start a new one, or open a template."
                                   Style="{StaticResource Muted}" FontSize="11"
                                   HorizontalAlignment="Center" Margin="0,8,0,0" />
                        <Button Style="{StaticResource BtnSmall}" Content="NEW DOCUMENT" Margin="0,16,0,0"
                                HorizontalAlignment="Center" Command="{Binding NewCommand}" />
                    </StackPanel>
                </Grid>

                <!-- Footer -->
                <Border Grid.Row="2" Padding="20,11" BorderThickness="0,1,0,0"
                        BorderBrush="{StaticResource BrushBorderSoft}">
                    <Grid>
                        <TextBlock Style="{StaticResource Muted}" FontSize="10" VerticalAlignment="Center"
                                   Text="Documents are stored inside NEXUS and appear in the file library, search and the audit trail." />
                        <Button HorizontalAlignment="Right" Style="{StaticResource BtnSmallGhost}"
                                Content="OPEN FILE LIBRARY" Command="{Binding OpenFilesCommand}" />
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
