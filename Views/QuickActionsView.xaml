<UserControl x:Class="NEXUS.Views.QuickActionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:NEXUS.Controls">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,0,20,24">
        <StackPanel Margin="0,0,8,0">

            <Border Style="{StaticResource Panel}" Padding="16,14">
                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{ctrl:Glyph Automation}" FontFamily="{StaticResource FontIcon}" FontSize="13"
                                   VerticalAlignment="Center" Foreground="{StaticResource BrushAccent}" />
                        <TextBlock Text="Every tile below performs a real operation on the current mission."
                                   Style="{StaticResource Caption}" Margin="10,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource Muted}" FontSize="10" HorizontalAlignment="Right"
                               VerticalAlignment="Center">
                        <Run Text="{Binding Shell.HeaderRemaining, Mode=OneWay}" /><Run Text=" OPEN &#183; " /><Run Text="{Binding Shell.CompactCountdown, Mode=OneWay}" /><Run Text=" TO DEADLINE" />
                    </TextBlock>
                </Grid>
            </Border>

            <ItemsControl ItemsSource="{Binding Actions}" Margin="0,14,0,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="4" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Margin="0,0,14,14" Height="160" Cursor="Hand" FocusVisualStyle="{x:Null}"
                                Command="{Binding Command}" CommandParameter="{Binding Parameter}"
                                HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Root" CornerRadius="10" Padding="18"
                                            Background="{StaticResource BrushPanelGradient}"
                                            BorderBrush="{StaticResource BrushBorder}" BorderThickness="1"
                                            RenderTransformOrigin="0.5,0.5">
                                        <Border.RenderTransform>
                                            <TranslateTransform x:Name="Lift" Y="0" />
                                        </Border.RenderTransform>
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Root" Property="BorderBrush"
                                                    Value="{StaticResource BrushAccent}" />
                                            <Setter TargetName="Root" Property="Background"
                                                    Value="{StaticResource BrushAccentFaint}" />
                                            <Trigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="Lift"
                                                                         Storyboard.TargetProperty="Y"
                                                                         To="-3" Duration="0:0:0.16" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.EnterActions>
                                            <Trigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="Lift"
                                                                         Storyboard.TargetProperty="Y"
                                                                         To="0" Duration="0:0:0.16" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.ExitActions>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Width="34" Height="34" CornerRadius="8"
                                        HorizontalAlignment="Left"
                                        Background="{StaticResource BrushPanelAlt}"
                                        BorderThickness="1"
                                        BorderBrush="{Binding BrushKey, Converter={StaticResource ResBrush}}">
                                    <TextBlock Text="{Binding Glyph, Converter={StaticResource Glyph}}" FontFamily="{StaticResource FontIcon}"
                                               FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="{Binding BrushKey, Converter={StaticResource ResBrush}}" />
                                </Border>

                                <StackPanel Grid.Row="1" VerticalAlignment="Bottom" Margin="0,14,0,0">
                                    <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Description}" Style="{StaticResource Muted}"
                                               FontSize="10.5" TextWrapping="Wrap" Margin="0,6,0,0" />
                                </StackPanel>

                                <TextBlock Grid.Row="2" Text="{Binding Shortcut}" Style="{StaticResource Mono}"
                                           FontSize="9.5" Margin="0,12,0,0"
                                           Foreground="{StaticResource BrushTextMuted}"
                                           Visibility="{Binding Shortcut, Converter={StaticResource StrToVis}}" />
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
