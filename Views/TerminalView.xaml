<UserControl x:Class="NEXUS.Views.TerminalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:NEXUS.Controls">

    <Grid Margin="28,0,20,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ================= OUTPUT ================= -->
        <Border Grid.Row="0" Style="{StaticResource Panel}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Padding="18,12" BorderThickness="0,0,0,1"
                        BorderBrush="{StaticResource BrushBorderSoft}">
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                     Fill="{StaticResource BrushCompleted}" />
                            <TextBlock Style="{StaticResource SectionLabel}" Margin="10,0,0,0"
                                       VerticalAlignment="Center" ctrl:Tracking.Text="NEXUS TERMINAL" />
                            <TextBlock Text="{Binding Prompt}" Style="{StaticResource CellMono}" Margin="14,0,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <Button HorizontalAlignment="Right" Style="{StaticResource BtnSmallGhost}" Content="CLEAR"
                                Command="{Binding ClearCommand}" />
                    </Grid>
                </Border>

                <ScrollViewer x:Name="OutputScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Auto" Padding="18,14">
                    <ItemsControl ItemsSource="{Binding Lines}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Text}" Style="{StaticResource ConsoleText}"
                                           Foreground="{Binding BrushKey, Converter={StaticResource ResBrush}}"
                                           Margin="0,0,0,2" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- ================= INPUT ================= -->
        <Border Grid.Row="1" Style="{StaticResource Panel}" Margin="0,14,0,0" Padding="18,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" VerticalAlignment="Center" Style="{StaticResource ConsoleText}"
                           Foreground="{StaticResource BrushAccent}">
                    <Run Text="{Binding Prompt, Mode=OneWay}" /><Run Text=" &gt;" />
                </TextBlock>

                <TextBox x:Name="InputBox" Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center"
                         Background="Transparent" BorderThickness="0" CaretBrush="{StaticResource BrushAccent}"
                         FontFamily="{StaticResource FontMono}" FontSize="12"
                         Foreground="{StaticResource BrushText}"
                         Text="{Binding Input, UpdateSourceTrigger=PropertyChanged}"
                         PreviewKeyDown="OnInputKeyDown" />

                <Button Grid.Column="2" Style="{StaticResource BtnSmall}" Content="RUN"
                        Command="{Binding SubmitCommand}" />
            </Grid>
        </Border>

        <!-- ================= SUGGESTIONS ================= -->
        <Border Grid.Row="2" Style="{StaticResource InsetPanel}" Margin="0,12,0,0" Padding="14,11">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionLabel}"
                           ctrl:Tracking.Text="COMMANDS &#183; TAB COMPLETES &#183; UP AND DOWN RECALL HISTORY" />
                <ItemsControl ItemsSource="{Binding Suggestions}" Margin="0,10,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource BtnSmallGhost}" Content="{Binding}" Margin="0,0,7,7"
                                    FontFamily="{StaticResource FontMono}"
                                    Command="{Binding DataContext.HintCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
