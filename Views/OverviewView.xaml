<UserControl x:Class="NEXUS.Views.OverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:NEXUS.Controls">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,0,20,24">
        <Grid Margin="0,0,8,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ================= ROW 1: STATUS + DEADLINE ================= -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="420" />
                    <ColumnDefinition Width="340" />
                </Grid.ColumnDefinitions>

                <!-- System status -->
                <Border Grid.Column="0" Style="{StaticResource Panel}" Margin="0,0,14,0">
                    <StackPanel>
                        <Grid>
                            <TextBlock Style="{StaticResource SectionLabel}" ctrl:Tracking.Text="SYSTEM STATUS" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Ellipse Width="6" Height="6" VerticalAlignment="Center"
                                         Fill="{Binding HealthBrushKey, Converter={StaticResource ResBrush}}" />
                                <TextBlock Text="{Binding HealthLabel}" FontSize="10" FontWeight="SemiBold"
                                           Margin="7,0,0,0" VerticalAlignment="Center"
                                           Foreground="{Binding HealthBrushKey, Converter={StaticResource ResBrush}}" />
                            </StackPanel>
                        </Grid>

                        <UniformGrid Columns="3" Margin="0,18,0,0">
                            <StackPanel Margin="0,0,12,16">
                                <TextBlock Text="{Binding Shell.SystemStatus}" Style="{StaticResource MetricValue}"
                                           FontSize="17" Foreground="{StaticResource BrushCompleted}" />
                                <TextBlock Style="{StaticResource MetricLabel}" ctrl:Tracking.Text="APPLICATION" />
                            </StackPanel>

                            <StackPanel Margin="0,0,12,16">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Shell.TimeDisplay}" Style="{StaticResource MetricValue}"
                                               FontSize="17" />
                                    <TextBlock Text="{Binding Shell.SecondsDisplay}" Style="{StaticResource Mono}"
                                               FontSize="11" VerticalAlignment="Bottom" Margin="3,0,0,1"
                                               Foreground="{StaticResource BrushTextMuted}" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource MetricLabel}" ctrl:Tracking.Text="LOCAL TIME" />
                            </StackPanel>

                            <StackPanel Margin="0,0,0,16">
                                <TextBlock Text="{Binding Shell.DateDisplay}" Style="{StaticResource MetricValue}"
                                           FontSize="17" />
                                <TextBlock Style="{StaticResource MetricLabel}" ctrl:Tracking.Text="DATE" />
                            </StackPanel>

                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="{Binding Remaining}" Style="{StaticResource MetricValue}"
                                           Foreground="{StaticResource BrushHigh}" />
                                <TextBlock Style="{StaticResource MetricLabel}" ctrl:Tracking.Text="TASKS REMAINING" />
                            </StackPanel>

                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="{Binding Completed}" Style="{StaticResource MetricValue}"
                                           Foreground="{StaticResource BrushCompleted}" />
                                <TextBlock Style="{StaticResource MetricLabel}" ctrl:Tracking.Text="TASKS COMPLETED" />
                            </StackPanel>

                            <StackPanel>
                                <TextBlock Text="{Binding CompletionPercent, StringFormat={}{0}%}"
                                           Style="{StaticResource MetricValue}"
                                           Foreground="{StaticResource BrushAccent}" />
                                <TextBlock Style="{StaticResource MetricLabel}" ctrl:Tracking.Text="COMPLETION" />
                            </StackPanel>
                        </UniformGrid>

                        <Border Style="{StaticResource Divider}" Margin="0,18,0,12" />

                        <StackPanel Orientation="Horizontal">
                            <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                                <Ellipse Width="6" Height="6" Fill="{StaticResource BrushAccent}" VerticalAlignment="Center" />
                                <TextBlock Style="{StaticResource Muted}" FontSize="10.5" Margin="7,0,0,0">
                                    <Run Text="{Binding InProgress, Mode=OneWay}" /><Run Text=" IN PROGRESS" />
                                </TextBlock>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                                <Ellipse Width="6" Height="6" Fill="{StaticResource BrushCritical}" VerticalAlignment="Center" />
                                <TextBlock Style="{StaticResource Muted}" FontSize="10.5" Margin="7,0,0,0">
                                    <Run Text="{Binding Blocked, Mode=OneWay}" /><Run Text=" BLOCKED" />
                                </TextBlock>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="6" Height="6" Fill="{StaticResource BrushHigh}" VerticalAlignment="Center" />
                                <TextBlock Style="{StaticResource Muted}" FontSize="10.5" Margin="7,0,0,0">
                                    <Run Text="{Binding Overdue, Mode=OneWay}" /><Run Text=" OVERDUE" />
                                </TextBlock>
                            </StackPanel>
                            <TextBlock Style="{StaticResource Muted}" FontSize="10.5" Margin="20,0,0,0"
                                       HorizontalAlignment="Right">
                                <Run Text="UPTIME " /><Run Text="{Binding Shell.UptimeDisplay, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Deadline countdown -->
                <Border Grid.Column="1" Style="{StaticResource Panel}">
                    <StackPanel>
                        <Grid>
                            <TextBlock Style="{StaticResource SectionLabel}" ctrl:Tracking.Text="DEADLINE" />
                            <TextBlock Text="{Binding Shell.DeadlineStatusText}" FontSize="9.5" FontWeight="SemiBold"
                                       HorizontalAlignment="Right"
                                       Foreground="{Binding Shell.DeadlineBrushKey, Converter={StaticResource ResBrush}}" />
                        </Grid>

                        <TextBlock Text="{Binding Shell.DeadlineDayName}" FontSize="21" FontWeight="SemiBold"
                                   Margin="0,12,0,0" />
                        <TextBlock Text="{Binding Shell.DeadlineDateText}" Style="{StaticResource Muted}"
                                   FontSize="10.5" Margin="0,3,0,0" />

                        <Grid Margin="0,20,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding Shell.DeadlineDays}" Style="{StaticResource Mono}"
                                           FontSize="30" FontWeight="SemiBold"
                                           Foreground="{Binding Shell.DeadlineBrushKey, Converter={StaticResource ResBrush}}" />
                                <TextBlock Style="{StaticResource MetricLabel}" ctrl:Tracking.Text="DAYS" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding Shell.DeadlineHours}" Style="{StaticResource Mono}"
                                           FontSize="30" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource MetricLabel}" ctrl:Tracking.Text="HRS" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{Binding Shell.DeadlineMinutes}" Style="{StaticResource Mono}"
                                           FontSize="30" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource MetricLabel}" ctrl:Tracking.Text="MIN" />
                            </StackPanel>
                            <StackPanel Grid.Column="3">
                                <TextBlock Text="{Binding Shell.DeadlineSeconds}" Style="{StaticResource Mono}"
                                           FontSize="30" FontWeight="SemiBold"
                                           Foreground="{StaticResource BrushTextDim}" />
                                <TextBlock Style="{StaticResource MetricLabel}" ctrl:Tracking.Text="SEC" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,20,0,0" Height="4">
                            <Border Style="{StaticResource SlimBar}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{Binding Shell.DeadlineFraction, Converter={StaticResource FracStar}}" />
                                    <ColumnDefinition Width="{Binding Shell.DeadlineFraction, Converter={StaticResource FracStarRem}}" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Height="4" CornerRadius="2"
                                        Background="{Binding Shell.DeadlineBrushKey, Converter={StaticResource ResBrush}}" />
                            </Grid>
                        </Grid>

                        <Border Margin="0,16,0,0" Padding="10,8" CornerRadius="6"
                                Background="#22FF5470" BorderBrush="{StaticResource BrushCritical}" BorderThickness="1"
                                Visibility="{Binding Shell.IsDeadlinePassed, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{ctrl:Glyph Warning}" FontFamily="{StaticResource FontIcon}" FontSize="11"
                                           Foreground="{StaticResource BrushCritical}" VerticalAlignment="Center" />
                                <TextBlock Text="MISSION DEADLINE HAS PASSED" FontSize="10" FontWeight="SemiBold"
                                           Margin="8,0,0,0" VerticalAlignment="Center"
                                           Foreground="{StaticResource BrushCritical}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ================= ROW 2: MISSION PROGRESS ================= -->
            <Border Grid.Row="1" Style="{StaticResource Panel}" Margin="0,14,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Width="112" Height="112" Margin="0,4,26,4">
                        <ctrl:RingGauge Value="{Binding CompletionFraction}" RingThickness="9"
                                        TrackBrush="{StaticResource BrushBorderSoft}"
                                        ValueBrush="{StaticResource BrushAccent}" />
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="{Binding CompletionPercent, StringFormat={}{0}%}"
                                       Style="{StaticResource Mono}" FontSize="24" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" />
                            <TextBlock Style="{StaticResource Muted}" FontSize="9" HorizontalAlignment="Center"
                                       ctrl:Tracking.Text="COMPLETE" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <Grid>
                            <TextBlock Style="{StaticResource SectionLabel}" ctrl:Tracking.Text="MISSION PROGRESS" />
                            <TextBlock Text="{Binding TotalLabel}" Style="{StaticResource Caption}"
                                       FontWeight="SemiBold" HorizontalAlignment="Right" />
                        </Grid>

                        <!-- One segment per task, coloured by status -->
                        <ItemsControl ItemsSource="{Binding Segments}" Margin="0,14,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Height="26" Margin="0,0,4,0" CornerRadius="4"
                                            Background="{Binding State, Converter={StaticResource StateBrush}}"
                                            Opacity="0.9" ToolTip="{Binding Title}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCompleted}" Value="False">
                                                        <Setter Property="Opacity" Value="0.22" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Grid Margin="0,16,0,0">
                            <StackPanel Orientation="Horizontal">
                                <StackPanel Margin="0,0,28,0">
                                    <TextBlock Text="{Binding Completed}" Style="{StaticResource Mono}"
                                               FontSize="19" FontWeight="SemiBold"
                                               Foreground="{StaticResource BrushCompleted}" />
                                    <TextBlock Style="{StaticResource MetricLabel}" ctrl:Tracking.Text="COMPLETED" />
                                </StackPanel>
                                <StackPanel Margin="0,0,28,0">
                                    <TextBlock Text="{Binding Remaining}" Style="{StaticResource Mono}"
                                               FontSize="19" FontWeight="SemiBold"
                                               Foreground="{StaticResource BrushHigh}" />
                                    <TextBlock Style="{StaticResource MetricLabel}" ctrl:Tracking.Text="REMAINING" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="{Binding Total}" Style="{StaticResource Mono}"
                                               FontSize="19" FontWeight="SemiBold" />
                                    <TextBlock Style="{StaticResource MetricLabel}" ctrl:Tracking.Text="TOTAL" />
                                </StackPanel>
                            </StackPanel>

                            <TextBlock Style="{StaticResource Muted}" FontSize="10" HorizontalAlignment="Right"
                                       VerticalAlignment="Bottom" Text="EACH BLOCK IS ONE TASK" />
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ================= ROW 3: ACTIVE TASKS + ACTIVITY ================= -->
            <Grid Grid.Row="2" Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="380" />
                    <ColumnDefinition Width="340" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Panel}" Margin="0,0,14,0">
                    <StackPanel>
                        <Grid>
                            <TextBlock Style="{StaticResource SectionLabel}" ctrl:Tracking.Text="ACTIVE TASKS" />
                            <Button HorizontalAlignment="Right" Style="{StaticResource BtnGhost}" Padding="10,5"
                                    Content="VIEW ALL" FontSize="9.5"
                                    Command="{Binding Shell.ShowTasksCommand}" CommandParameter="ALL" />
                        </Grid>

                        <ItemsControl ItemsSource="{Binding ActiveTasks}" Margin="0,14,0,0"
                                      ItemTemplate="{StaticResource TaskRowTemplate}" />

                        <Border Padding="20" CornerRadius="8" Background="{StaticResource BrushPanelAlt}"
                                Visibility="{Binding ActiveTasks.Count, Converter={StaticResource CountToVisInv}}">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="{ctrl:Glyph Command}" FontFamily="{StaticResource FontIcon}" FontSize="22"
                                           HorizontalAlignment="Center"
                                           Foreground="{StaticResource BrushCompleted}" />
                                <TextBlock Text="ALL TASKS CLEARED" FontSize="11" FontWeight="SemiBold"
                                           Margin="0,10,0,0" HorizontalAlignment="Center" />
                                <TextBlock Text="Nothing is open against this mission." Style="{StaticResource Muted}"
                                           Margin="0,4,0,0" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource Panel}">
                    <StackPanel>
                        <Grid>
                            <TextBlock Style="{StaticResource SectionLabel}" ctrl:Tracking.Text="ACTIVITY LOG" />
                            <Button HorizontalAlignment="Right" Style="{StaticResource BtnGhost}" Padding="10,5"
                                    Content="FULL LOG" FontSize="9.5"
                                    Command="{Binding Shell.NavigateCommand}" CommandParameter="ACTIVITY" />
                        </Grid>

                        <ItemsControl ItemsSource="{Binding RecentActivity}" Margin="0,14,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding TimeDisplay}"
                                                   Style="{StaticResource Mono}" FontSize="10.5"
                                                   Foreground="{StaticResource BrushTextMuted}"
                                                   VerticalAlignment="Top" />

                                        <Border Grid.Column="1" Width="2" Margin="10,3,10,0" CornerRadius="1"
                                                Background="{Binding Kind, Converter={StaticResource ActivityBrush}}" />

                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="{Binding Message}" FontSize="11.5"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}"
                                                       FontSize="10" TextTrimming="CharacterEllipsis"
                                                       Visibility="{Binding Detail, Converter={StaticResource StrToVis}}"
                                                       Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="No activity recorded yet." Style="{StaticResource Muted}"
                                   Margin="0,10,0,0"
                                   Visibility="{Binding RecentActivity.Count, Converter={StaticResource CountToVisInv}}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
