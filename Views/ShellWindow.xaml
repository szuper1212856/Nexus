<Window x:Class="NEXUS.Views.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:ctrl="clr-namespace:NEXUS.Controls"
        Title="NEXUS — Personal Command Center"
        Width="1420" Height="920" MinWidth="1080" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="{StaticResource BrushBg0}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6"
                            CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.InputBindings>
        <KeyBinding Modifiers="Control" Key="N" Command="{Binding NewTaskCommand}" />
        <KeyBinding Modifiers="Control" Key="F" Command="{Binding StartFocusCommand}" />
        <KeyBinding Modifiers="Control" Key="Space" Command="{Binding OpenSearchCommand}" />
        <KeyBinding Modifiers="Control" Key="R" Command="{Binding SweepCommand}" />
        <KeyBinding Modifiers="Control" Key="D1" Command="{Binding NavigateCommand}" CommandParameter="COMMAND" />
        <KeyBinding Modifiers="Control" Key="D2" Command="{Binding NavigateCommand}" CommandParameter="DEVICES" />
        <KeyBinding Modifiers="Control" Key="D3" Command="{Binding NavigateCommand}" CommandParameter="NETWORK" />
        <KeyBinding Modifiers="Control" Key="D4" Command="{Binding NavigateCommand}" CommandParameter="SERVERS" />
        <KeyBinding Modifiers="Control" Key="D5" Command="{Binding NavigateCommand}" CommandParameter="SECURITY" />
        <KeyBinding Modifiers="Control" Key="D6" Command="{Binding NavigateCommand}" CommandParameter="USERS" />
        <KeyBinding Modifiers="Control" Key="D7" Command="{Binding NavigateCommand}" CommandParameter="ACCESS" />
        <KeyBinding Modifiers="Control" Key="D8" Command="{Binding NavigateCommand}" CommandParameter="TERMINAL" />
        <KeyBinding Modifiers="Control" Key="D9" Command="{Binding NavigateCommand}" CommandParameter="TASKS" />
        <KeyBinding Modifiers="Control" Key="D0" Command="{Binding NavigateCommand}" CommandParameter="SETTINGS" />
    </Window.InputBindings>

    <Border x:Name="RootBorder" Background="{StaticResource BrushWindow}"
            BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ================= TITLE BAR ================= -->
            <Grid Grid.Row="0" x:Name="TitleBar" Background="Transparent"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                    <Border Width="16" Height="16" CornerRadius="4" Background="{StaticResource BrushAccentGradient}" />
                    <TextBlock Text="NEXUS" FontWeight="Bold" FontSize="12" Margin="10,0,0,0"
                               VerticalAlignment="Center" />
                    <Border Width="1" Height="12" Background="{StaticResource BrushBorder}" Margin="10,0" />
                    <TextBlock Style="{StaticResource Muted}" FontSize="10.5" VerticalAlignment="Center"
                               ctrl:Tracking.Text="PERSONAL COMMAND CENTER" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <Ellipse x:Name="StatusDot" Width="6" Height="6" Fill="{StaticResource BrushCompleted}"
                             VerticalAlignment="Center">
                        <Ellipse.Triggers>
                            <EventTrigger RoutedEvent="Ellipse.Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                         From="1" To="0.28" Duration="0:0:1.6" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Ellipse.Triggers>
                    </Ellipse>
                    <TextBlock Text="{Binding SystemStatus}" Style="{StaticResource Muted}" FontSize="10"
                               Margin="8,0,0,0" VerticalAlignment="Center" />
                    <Border Width="1" Height="12" Background="{StaticResource BrushBorder}" Margin="12,0" />
                    <TextBlock Style="{StaticResource Mono}" FontSize="11" Foreground="{StaticResource BrushTextDim}"
                               VerticalAlignment="Center">
                        <Run Text="{Binding TimeDisplay, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Style="{StaticResource BtnCaption}" Content="{ctrl:Glyph Minimize}" Click="Minimize_Click"
                            ToolTip="Minimize" />
                    <Button Style="{StaticResource BtnCaption}" x:Name="MaxButton" Content="{ctrl:Glyph Maximize}"
                            Click="Maximize_Click" ToolTip="Maximize" />
                    <Button Style="{StaticResource BtnClose}" Content="{ctrl:Glyph Close}" Click="Close_Click"
                            ToolTip="Close" />
                </StackPanel>
            </Grid>

            <!-- ================= BODY ================= -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="228" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Sidebar -->
                <Border Grid.Column="0" Background="{StaticResource BrushPanelAlt}"
                        BorderBrush="{StaticResource BrushBorderSoft}" BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="16,18,16,10">
                            <Border Background="{StaticResource BrushPanel}"
                                    BorderBrush="{StaticResource BrushBorderSoft}" BorderThickness="1"
                                    CornerRadius="8" Padding="12,11">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="34" Height="34" CornerRadius="17"
                                                Background="{StaticResource BrushPanelAlt}" BorderThickness="1.5"
                                                BorderBrush="{StaticResource BrushAccent}">
                                            <TextBlock Text="{Binding OperatorInitials}" FontSize="11.5"
                                                       FontWeight="SemiBold" HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Foreground="{StaticResource BrushAccent}" />
                                        </Border>
                                        <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding OperatorName}" FontSize="12"
                                                       FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                       MaxWidth="120" HorizontalAlignment="Left" />
                                            <TextBlock Text="{Binding OperatorRole}" Style="{StaticResource Muted}"
                                                       FontSize="8.5" Margin="0,3,0,0" />
                                        </StackPanel>
                                    </StackPanel>

                                    <Border Style="{StaticResource Divider}" Margin="0,11,0,10" />

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="6" Height="6" VerticalAlignment="Center"
                                                         Fill="{Binding NetworkBrushKey, Converter={StaticResource ResBrush}}" />
                                                <TextBlock Text="{Binding NetworkStatus}" FontSize="9"
                                                           FontWeight="SemiBold" Margin="6,0,0,0"
                                                           VerticalAlignment="Center"
                                                           Foreground="{Binding NetworkBrushKey, Converter={StaticResource ResBrush}}" />
                                            </StackPanel>
                                            <TextBlock Style="{StaticResource MetricLabel}" FontSize="7.5"
                                                       ctrl:Tracking.Text="NETWORK" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="6" Height="6" VerticalAlignment="Center"
                                                         Fill="{Binding SecurityBrushKey, Converter={StaticResource ResBrush}}" />
                                                <TextBlock Text="{Binding SecurityPosture}" FontSize="9"
                                                           FontWeight="SemiBold" Margin="6,0,0,0"
                                                           VerticalAlignment="Center"
                                                           Foreground="{Binding SecurityBrushKey, Converter={StaticResource ResBrush}}" />
                                            </StackPanel>
                                            <TextBlock Style="{StaticResource MetricLabel}" FontSize="7.5"
                                                       ctrl:Tracking.Text="SECURITY" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Button Style="{StaticResource BtnGhost}" Margin="0,10,0,0" Padding="10,7"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                    Command="{Binding OpenSearchCommand}" ToolTip="Global search (Ctrl+Space)">
                                <Grid>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                        <TextBlock Text="{ctrl:Glyph Search}" FontFamily="{StaticResource FontIcon}"
                                                   FontSize="10" VerticalAlignment="Center" />
                                        <TextBlock Text="SEARCH" FontSize="9.5" Margin="8,0,0,0"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Text="CTRL+SPACE" FontSize="8" HorizontalAlignment="Right"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource BrushTextMuted}" />
                                </Grid>
                            </Button>
                        </StackPanel>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Focusable="False">
                            <ItemsControl ItemsSource="{Binding Sections}" Margin="0,2,0,10" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <!-- Group caption -->
                                            <TextBlock Text="{Binding Label}" Style="{StaticResource NavGroupLabel}"
                                                       Visibility="{Binding IsHeader, Converter={StaticResource BoolToVis}}" />

                                            <!-- Navigable entry -->
                                            <Grid Visibility="{Binding IsHeader, Converter={StaticResource BoolToVisInv}}">
                                                <RadioButton Style="{StaticResource NavItem}"
                                                             GroupName="Nav"
                                                             Content="{Binding Label}"
                                                             Tag="{Binding Glyph, Converter={StaticResource Glyph}}"
                                                             IsChecked="{Binding IsSelected, Mode=OneWay}"
                                                             Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                             CommandParameter="{Binding Key}" />

                                                <Border CornerRadius="8" Padding="6,1" Margin="0,0,18,0"
                                                        HorizontalAlignment="Right" VerticalAlignment="Center"
                                                        IsHitTestVisible="False"
                                                        Background="{StaticResource BrushAccentSoft}"
                                                        Visibility="{Binding HasBadge, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="{Binding Badge}" FontSize="8.5"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource BrushText}" />
                                                </Border>
                                            </Grid>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- Deadline summary pinned to the bottom of the rail -->
                        <Border Grid.Row="2" Margin="14,10,14,14" Padding="14,12"
                                Background="{StaticResource BrushPanel}"
                                BorderBrush="{StaticResource BrushBorderSoft}" BorderThickness="1"
                                CornerRadius="8">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionLabel}" ctrl:Tracking.Text="DEADLINE" />
                                <TextBlock Text="{Binding DeadlineDayName}" FontWeight="SemiBold" FontSize="13"
                                           Margin="0,6,0,0" />
                                <TextBlock Text="{Binding CompactCountdown}" Style="{StaticResource Mono}"
                                           FontSize="12" Margin="0,4,0,0"
                                           Foreground="{Binding DeadlineBrushKey, Converter={StaticResource ResBrush}}" />
                                <TextBlock Text="{Binding DeadlineDateText}" Style="{StaticResource Muted}"
                                           FontSize="10" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Content column -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Page header -->
                    <Grid Grid.Row="0" Margin="28,22,28,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding CurrentTitle}" Style="{StaticResource PageTitle}" />
                            <TextBlock Text="{Binding CurrentSubtitle}" Style="{StaticResource Muted}"
                                       Margin="0,3,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Style="{StaticResource InsetPanel}" Padding="14,8" Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Mono}" FontSize="15" FontWeight="SemiBold"
                                               Text="{Binding TimeDisplay}" VerticalAlignment="Center" />
                                    <TextBlock Style="{StaticResource Mono}" FontSize="10"
                                               Foreground="{StaticResource BrushTextMuted}" Margin="2,0,0,0"
                                               VerticalAlignment="Bottom" Text="{Binding SecondsDisplay}" />
                                    <Border Width="1" Background="{StaticResource BrushBorder}" Margin="12,2" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DayDisplay}" Style="{StaticResource Muted}" FontSize="9.5" />
                                        <TextBlock Text="{Binding DateDisplay}" Style="{StaticResource Caption}" FontSize="11" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Live subsystem indicators -->
                            <Border Style="{StaticResource InsetPanel}" Padding="14,8" Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource Mono}" FontSize="12" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center">
                                            <Run Text="{Binding DeviceOnline, Mode=OneWay}" /><Run Text="/" /><Run Text="{Binding DeviceTotal, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock Style="{StaticResource MetricLabel}" FontSize="7.5"
                                                   HorizontalAlignment="Center" ctrl:Tracking.Text="DEVICES" />
                                    </StackPanel>
                                    <Border Width="1" Background="{StaticResource BrushBorder}" Margin="12,2" />
                                    <StackPanel>
                                        <TextBlock Text="{Binding ServicesRunning}" Style="{StaticResource Mono}"
                                                   FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                        <TextBlock Style="{StaticResource MetricLabel}" FontSize="7.5"
                                                   HorizontalAlignment="Center" ctrl:Tracking.Text="SERVICES" />
                                    </StackPanel>
                                    <Border Width="1" Background="{StaticResource BrushBorder}" Margin="12,2" />
                                    <StackPanel>
                                        <TextBlock Text="{Binding CpuPercent}" Style="{StaticResource Mono}"
                                                   FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                        <TextBlock Style="{StaticResource MetricLabel}" FontSize="7.5"
                                                   HorizontalAlignment="Center" ctrl:Tracking.Text="CPU" />
                                    </StackPanel>
                                    <Border Width="1" Background="{StaticResource BrushBorder}" Margin="12,2" />
                                    <StackPanel>
                                        <TextBlock Text="{Binding MemoryPercent}" Style="{StaticResource Mono}"
                                                   FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                        <TextBlock Style="{StaticResource MetricLabel}" FontSize="7.5"
                                                   HorizontalAlignment="Center" ctrl:Tracking.Text="MEM" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Alert indicator -->
                            <Button Style="{StaticResource BtnGhost}" Padding="12,9" Margin="0,0,10,0"
                                    Command="{Binding NavigateCommand}" CommandParameter="SECURITY"
                                    ToolTip="Open the security console"
                                    Visibility="{Binding HasAlerts, Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{ctrl:Glyph Warning}" FontFamily="{StaticResource FontIcon}" FontSize="11"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource BrushCritical}" />
                                    <TextBlock Text="{Binding AlertCount}" Margin="8,0,0,0" FontSize="11"
                                               FontWeight="SemiBold" VerticalAlignment="Center"
                                               Foreground="{StaticResource BrushCritical}" />
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource BtnGhost}" Padding="11,9" Margin="0,0,10,0"
                                    Content="{ctrl:Glyph Search}" FontFamily="{StaticResource FontIcon}" FontSize="12"
                                    Command="{Binding OpenSearchCommand}" ToolTip="Global search (Ctrl+Space)" />

                            <Button Style="{StaticResource BtnGhost}" Padding="11,9" Margin="0,0,10,0"
                                    Content="{ctrl:Glyph Refresh}" FontFamily="{StaticResource FontIcon}" FontSize="12"
                                    Command="{Binding SweepCommand}" ToolTip="Run a system check (Ctrl+R)" />

                            <Button Style="{StaticResource BtnPrimary}" Command="{Binding NewTaskCommand}"
                                    ToolTip="Create a new task (Ctrl+N)">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{ctrl:Glyph Add}" FontFamily="{StaticResource FontIcon}" FontSize="11"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="NEW TASK" Margin="8,0,0,0" FontSize="11" FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Active section -->
                    <ContentControl x:Name="SectionHost" Grid.Row="1" Content="{Binding CurrentViewModel}"
                                    Margin="0,0,0,0" RenderTransformOrigin="0.5,0.5">
                        <ContentControl.RenderTransform>
                            <TranslateTransform x:Name="SectionShift" Y="0" />
                        </ContentControl.RenderTransform>
                    </ContentControl>
                </Grid>
            </Grid>

            <!-- ================= GLOBAL SEARCH ================= -->
            <Border Grid.Row="0" Grid.RowSpan="2" Background="{StaticResource BrushOverlay}"
                    Visibility="{Binding Search.IsOpen, Converter={StaticResource BoolToVis}}">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding Search.CloseCommand}" />
                </Border.InputBindings>

                <Border Width="620" MaxHeight="480" VerticalAlignment="Top" Margin="0,110,0,0"
                        Background="{StaticResource BrushPanel}" CornerRadius="12"
                        BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="18,16,18,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="{ctrl:Glyph Search}" FontFamily="{StaticResource FontIcon}"
                                       FontSize="15" VerticalAlignment="Center"
                                       Foreground="{StaticResource BrushAccent}" />

                            <Grid Grid.Column="1" Margin="14,0,0,0">
                                <TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0"
                                         FontSize="16" VerticalAlignment="Center"
                                         CaretBrush="{StaticResource BrushAccent}"
                                         Foreground="{StaticResource BrushText}"
                                         Text="{Binding Search.Query, UpdateSourceTrigger=PropertyChanged}"
                                         PreviewKeyDown="OnSearchKeyDown" />
                                <TextBlock Text="Search NEXUS" IsHitTestVisible="False" FontSize="16"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource BrushTextMuted}"
                                           Visibility="{Binding Search.Query, Converter={StaticResource StrToVisInv}}" />
                            </Grid>
                        </Grid>

                        <Border Grid.Row="0" Height="1" VerticalAlignment="Bottom"
                                Background="{StaticResource BrushBorderSoft}" />

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="10,10,6,10">
                            <ItemsControl ItemsSource="{Binding Search.Results}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource RowItem}" Margin="0,0,0,2"
                                                HorizontalContentAlignment="Stretch"
                                                Command="{Binding DataContext.Search.ChooseCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0" Text="{Binding Glyph, Converter={StaticResource Glyph}}"
                                                           FontFamily="{StaticResource FontIcon}" FontSize="13"
                                                           VerticalAlignment="Center" Margin="4,0,14,0"
                                                           Foreground="{Binding BrushKey, Converter={StaticResource ResBrush}}" />

                                                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                                    <TextBlock Text="{Binding Title}" FontSize="12.5"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource CellDim}"
                                                               Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>

                                                <Border Grid.Column="2" Style="{StaticResource Pill}"
                                                        BorderBrush="{StaticResource BrushBorder}" Margin="0,0,4,0">
                                                    <TextBlock Style="{StaticResource PillText}"
                                                               Text="{Binding Category}"
                                                               Foreground="{StaticResource BrushTextMuted}" />
                                                </Border>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <Border Grid.Row="2" Padding="18,11" BorderThickness="0,1,0,0"
                                BorderBrush="{StaticResource BrushBorderSoft}">
                            <Grid>
                                <TextBlock Text="{Binding Search.Summary}" Style="{StaticResource Muted}"
                                           FontSize="10" VerticalAlignment="Center" />
                                <TextBlock Style="{StaticResource Muted}" FontSize="9" HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           ctrl:Tracking.Text="ENTER OPENS &#183; ESC CLOSES" />
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Border>

            <!-- ================= TOASTS ================= -->
            <ItemsControl Grid.Row="1" ItemsSource="{Binding Toasts}"
                          HorizontalAlignment="Right" VerticalAlignment="Bottom"
                          Margin="0,0,26,26" Width="330" IsHitTestVisible="True">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,8,0,0" Padding="14,12" CornerRadius="8"
                                Background="{StaticResource BrushPanel}"
                                BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.55" Color="#000000" />
                            </Border.Effect>
                            <Border.Triggers>
                                <EventTrigger RoutedEvent="Border.Loaded">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                             From="0" To="1" Duration="0:0:0.22" />
                                            <DoubleAnimation
                                                Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                From="24" To="0" Duration="0:0:0.28">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Border.Triggers>
                            <Border.RenderTransform>
                                <TranslateTransform X="0" />
                            </Border.RenderTransform>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="3" CornerRadius="2" Margin="0,0,12,0"
                                        Background="{Binding Kind, Converter={StaticResource ToastBrush}}" />

                                <StackPanel Grid.Column="1">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Glyph, Converter={StaticResource Glyph}}" FontFamily="{StaticResource FontIcon}"
                                                   FontSize="11" VerticalAlignment="Center"
                                                   Foreground="{Binding Kind, Converter={StaticResource ToastBrush}}" />
                                        <TextBlock Text="{Binding Title}" FontSize="11" FontWeight="SemiBold"
                                                   Margin="8,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding Message}" Style="{StaticResource Muted}"
                                               TextWrapping="Wrap" Margin="0,5,0,0"
                                               Visibility="{Binding Message, Converter={StaticResource StrToVis}}" />
                                </StackPanel>

                                <Button Grid.Column="2" Style="{StaticResource BtnIcon}" Width="22" Height="22"
                                        Content="{ctrl:Glyph Close}" FontSize="8" VerticalAlignment="Top"
                                        Command="{Binding DataContext.DismissToastCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </Border>
</Window>
