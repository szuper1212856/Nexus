<UserControl x:Class="NEXUS.Views.TasksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:NEXUS.Controls">

    <Grid Margin="28,0,20,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ================= TOOLBAR ================= -->
        <Border Grid.Row="0" Style="{StaticResource Panel}" Padding="16" Margin="0,0,8,0">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Search -->
                    <Grid Grid.Column="0" MaxWidth="420" HorizontalAlignment="Left">
                        <TextBox Style="{StaticResource Input}" Padding="34,8,10,8"
                                 Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=120}" />
                        <TextBlock Text="{ctrl:Glyph Search}" FontFamily="{StaticResource FontIcon}" FontSize="12"
                                   Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                   Foreground="{StaticResource BrushTextMuted}" />
                        <TextBlock Text="Search tasks, notes and subtasks" IsHitTestVisible="False"
                                   Margin="34,0,0,0" VerticalAlignment="Center"
                                   Foreground="{StaticResource BrushTextMuted}" FontSize="12.5"
                                   Visibility="{Binding Search, Converter={StaticResource StrToVisInv}}" />
                    </Grid>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                Margin="14,0,14,0">
                        <TextBlock Style="{StaticResource SectionLabel}" VerticalAlignment="Center"
                                   Margin="0,0,10,0" ctrl:Tracking.Text="SORT" />
                        <ComboBox Style="{StaticResource Combo}" Width="130"
                                  ItemsSource="{Binding SortModes}"
                                  SelectedItem="{Binding SortMode}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource SectionLabel}" VerticalAlignment="Center"
                                   Margin="0,0,10,0" ctrl:Tracking.Text="HIDE DONE" />
                        <CheckBox Style="{StaticResource Switch}" VerticalAlignment="Center"
                                  IsChecked="{Binding HideCompleted}" />
                        <Button Style="{StaticResource BtnGhost}" Content="RESET" Padding="12,7" Margin="14,0,0,0"
                                Command="{Binding ClearFiltersCommand}" />
                    </StackPanel>
                </Grid>

                <Border Style="{StaticResource Divider}" Margin="0,14,0,12" />

                <!-- Filter chips -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <TextBlock Style="{StaticResource SectionLabel}" VerticalAlignment="Center"
                                   Margin="0,0,12,0" ctrl:Tracking.Text="STATUS" />
                        <ToggleButton Style="{StaticResource Chip}" Content="ALL"
                                      IsChecked="{Binding StateFilter, Converter={StaticResource EqBool}, ConverterParameter=ALL, Mode=OneWay}"
                                      Command="{Binding SetStateFilterCommand}" CommandParameter="ALL" />
                        <ToggleButton Style="{StaticResource Chip}" Content="ACTIVE"
                                      IsChecked="{Binding StateFilter, Converter={StaticResource EqBool}, ConverterParameter=ACTIVE, Mode=OneWay}"
                                      Command="{Binding SetStateFilterCommand}" CommandParameter="ACTIVE" />
                        <ToggleButton Style="{StaticResource Chip}" Content="PLANNED"
                                      IsChecked="{Binding StateFilter, Converter={StaticResource EqBool}, ConverterParameter=Planned, Mode=OneWay}"
                                      Command="{Binding SetStateFilterCommand}" CommandParameter="Planned" />
                        <ToggleButton Style="{StaticResource Chip}" Content="IN PROGRESS"
                                      IsChecked="{Binding StateFilter, Converter={StaticResource EqBool}, ConverterParameter=InProgress, Mode=OneWay}"
                                      Command="{Binding SetStateFilterCommand}" CommandParameter="InProgress" />
                        <ToggleButton Style="{StaticResource Chip}" Content="BLOCKED"
                                      IsChecked="{Binding StateFilter, Converter={StaticResource EqBool}, ConverterParameter=Blocked, Mode=OneWay}"
                                      Command="{Binding SetStateFilterCommand}" CommandParameter="Blocked" />
                        <ToggleButton Style="{StaticResource Chip}" Content="COMPLETED"
                                      IsChecked="{Binding StateFilter, Converter={StaticResource EqBool}, ConverterParameter=Completed, Mode=OneWay}"
                                      Command="{Binding SetStateFilterCommand}" CommandParameter="Completed" />
                        <ToggleButton Style="{StaticResource Chip}" Content="OVERDUE"
                                      IsChecked="{Binding StateFilter, Converter={StaticResource EqBool}, ConverterParameter=OVERDUE, Mode=OneWay}"
                                      Command="{Binding SetStateFilterCommand}" CommandParameter="OVERDUE" />
                        <ToggleButton Style="{StaticResource Chip}" Content="TODAY"
                                      IsChecked="{Binding StateFilter, Converter={StaticResource EqBool}, ConverterParameter=TODAY, Mode=OneWay}"
                                      Command="{Binding SetStateFilterCommand}" CommandParameter="TODAY" />
                        <ToggleButton Style="{StaticResource Chip}" Content="DEADLINE"
                                      IsChecked="{Binding StateFilter, Converter={StaticResource EqBool}, ConverterParameter=DEADLINE, Mode=OneWay}"
                                      Command="{Binding SetStateFilterCommand}" CommandParameter="DEADLINE" />
                    </StackPanel>

                    <TextBlock Grid.Column="2" Text="{Binding ResultSummary}" Style="{StaticResource Caption}"
                               FontWeight="SemiBold" VerticalAlignment="Center" />
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <TextBlock Style="{StaticResource SectionLabel}" VerticalAlignment="Center"
                               Margin="0,0,12,0" ctrl:Tracking.Text="PRIORITY" />
                    <ToggleButton Style="{StaticResource Chip}" Content="ALL"
                                  IsChecked="{Binding PriorityFilter, Converter={StaticResource EqBool}, ConverterParameter=ALL, Mode=OneWay}"
                                  Command="{Binding SetPriorityFilterCommand}" CommandParameter="ALL" />
                    <ToggleButton Style="{StaticResource Chip}" Content="CRITICAL"
                                  IsChecked="{Binding PriorityFilter, Converter={StaticResource EqBool}, ConverterParameter=Critical, Mode=OneWay}"
                                  Command="{Binding SetPriorityFilterCommand}" CommandParameter="Critical" />
                    <ToggleButton Style="{StaticResource Chip}" Content="HIGH"
                                  IsChecked="{Binding PriorityFilter, Converter={StaticResource EqBool}, ConverterParameter=High, Mode=OneWay}"
                                  Command="{Binding SetPriorityFilterCommand}" CommandParameter="High" />
                    <ToggleButton Style="{StaticResource Chip}" Content="NORMAL"
                                  IsChecked="{Binding PriorityFilter, Converter={StaticResource EqBool}, ConverterParameter=Normal, Mode=OneWay}"
                                  Command="{Binding SetPriorityFilterCommand}" CommandParameter="Normal" />
                    <ToggleButton Style="{StaticResource Chip}" Content="LOW"
                                  IsChecked="{Binding PriorityFilter, Converter={StaticResource EqBool}, ConverterParameter=Low, Mode=OneWay}"
                                  Command="{Binding SetPriorityFilterCommand}" CommandParameter="Low" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ================= LIST ================= -->
        <Grid Grid.Row="1" Margin="0,14,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                <ItemsControl ItemsSource="{Binding Tasks}" ItemTemplate="{StaticResource TaskCardTemplate}" />
            </ScrollViewer>

            <!-- Empty state -->
            <Border Style="{StaticResource Panel}" Padding="40" VerticalAlignment="Top" Margin="0,0,8,0"
                    Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="{ctrl:Glyph Search}" FontFamily="{StaticResource FontIcon}" FontSize="26"
                               HorizontalAlignment="Center" Foreground="{StaticResource BrushTextMuted}" />
                    <TextBlock Text="NO TASKS MATCH THE CURRENT FILTERS" FontSize="12" FontWeight="SemiBold"
                               Margin="0,14,0,0" HorizontalAlignment="Center" />
                    <TextBlock Text="Adjust the search or reset the filters to see the full register."
                               Style="{StaticResource Muted}" Margin="0,6,0,0" HorizontalAlignment="Center" />
                    <Button Style="{StaticResource BtnGhost}" Content="RESET FILTERS" Margin="0,16,0,0"
                            HorizontalAlignment="Center" Command="{Binding ClearFiltersCommand}" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
