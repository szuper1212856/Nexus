<UserControl x:Class="NEXUS.Views.LogsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:NEXUS.Controls">

    <Grid Margin="28,0,20,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource Panel}" Padding="16">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Margin="0,0,12,0">
                        <TextBox Style="{StaticResource Input}" Padding="34,8,10,8"
                                 Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=120}" />
                        <TextBlock Text="{ctrl:Glyph Search}" FontFamily="{StaticResource FontIcon}" FontSize="12"
                                   Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                   Foreground="{StaticResource BrushTextMuted}" />
                        <TextBlock Text="Search messages, details, actors and sources" IsHitTestVisible="False"
                                   Margin="34,0,0,0" VerticalAlignment="Center" FontSize="12"
                                   Foreground="{StaticResource BrushTextMuted}"
                                   Visibility="{Binding Search, Converter={StaticResource StrToVisInv}}" />
                    </Grid>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Caption}" FontWeight="SemiBold" VerticalAlignment="Center"
                                   Margin="0,0,14,0">
                            <Run Text="{Binding Count, Mode=OneWay}" /><Run Text=" ENTRIES" />
                        </TextBlock>
                        <Button Style="{StaticResource BtnSmallGhost}" Content="CLEAR TRAIL"
                                Command="{Binding ClearCommand}" />
                    </StackPanel>
                </Grid>

                <ItemsControl ItemsSource="{Binding Filters}" Margin="0,12,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ToggleButton Style="{StaticResource Chip}" Content="{Binding}"
                                          Command="{Binding DataContext.SetFilterCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          CommandParameter="{Binding}">
                                <ToggleButton.IsChecked>
                                    <MultiBinding Converter="{StaticResource MultiEq}" Mode="OneWay">
                                        <Binding />
                                        <Binding Path="DataContext.Filter"
                                                 RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                    </MultiBinding>
                                </ToggleButton.IsChecked>
                            </ToggleButton>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource Panel}" Margin="0,14,0,0" Padding="14,14,8,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource TableHeaderBar}" Margin="0,0,6,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="72" />
                            <ColumnDefinition Width="60" />
                            <ColumnDefinition Width="92" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="130" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource ColHead}" ctrl:Tracking.Text="TIME" />
                        <TextBlock Grid.Column="1" Style="{StaticResource ColHead}" ctrl:Tracking.Text="DATE" />
                        <TextBlock Grid.Column="2" Style="{StaticResource ColHead}" ctrl:Tracking.Text="CATEGORY" />
                        <TextBlock Grid.Column="3" Style="{StaticResource ColHead}" ctrl:Tracking.Text="SEVERITY" />
                        <TextBlock Grid.Column="4" Style="{StaticResource ColHead}" ctrl:Tracking.Text="EVENT" />
                        <TextBlock Grid.Column="5" Style="{StaticResource ColHead}" ctrl:Tracking.Text="ACTOR" />
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding Entries}" Margin="0,0,6,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource DataRow}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="72" />
                                                <ColumnDefinition Width="60" />
                                                <ColumnDefinition Width="92" />
                                                <ColumnDefinition Width="80" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="130" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="{Binding TimeDisplay}"
                                                       Style="{StaticResource CellMono}" VerticalAlignment="Top" />
                                            <TextBlock Grid.Column="1" Text="{Binding DateDisplay}"
                                                       Style="{StaticResource CellDim}" FontSize="9.5"
                                                       VerticalAlignment="Top" />

                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                                                <Border Width="2" Height="12" CornerRadius="1" Margin="0,2,8,0"
                                                        Background="{Binding CategoryBrushKey, Converter={StaticResource ResBrush}}" />
                                                <TextBlock Text="{Binding CategoryLabel}" FontSize="9"
                                                           FontWeight="SemiBold" Margin="0,1,0,0"
                                                           Foreground="{Binding CategoryBrushKey, Converter={StaticResource ResBrush}}" />
                                            </StackPanel>

                                            <TextBlock Grid.Column="3" Text="{Binding SeverityLabel}" FontSize="9"
                                                       FontWeight="SemiBold" VerticalAlignment="Top" Margin="0,1,0,0"
                                                       Foreground="{Binding SeverityBrushKey, Converter={StaticResource ResBrush}}" />

                                            <StackPanel Grid.Column="4" Margin="0,0,12,0">
                                                <TextBlock Text="{Binding Message}" Style="{StaticResource Cell}"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Detail}" Style="{StaticResource CellDim}"
                                                           TextWrapping="Wrap" Margin="0,2,0,0"
                                                           Visibility="{Binding Detail, Converter={StaticResource StrToVis}}" />
                                            </StackPanel>

                                            <TextBlock Grid.Column="5" Text="{Binding Actor}"
                                                       Style="{StaticResource CellDim}" VerticalAlignment="Top"
                                                       TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="No events match the current filter." Style="{StaticResource Muted}"
                                   Margin="12,20,0,0"
                                   Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
