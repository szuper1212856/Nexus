<UserControl x:Class="NEXUS.Views.CommandCenterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:NEXUS.Controls">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,0,20,24">
        <Grid Margin="0,0,8,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ============ CORE BANNER ============ -->
            <Border Grid.Row="0" Style="{StaticResource Panel}" Padding="20,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="46" Height="46" CornerRadius="10"
                            Background="{StaticResource BrushAccentFaint}"
                            BorderBrush="{StaticResource BrushAccent}" BorderThickness="1">
                        <TextBlock Text="{ctrl:Glyph Command}" FontFamily="{StaticResource FontIcon}" FontSize="20"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{StaticResource BrushAccent}" />
                    </Border>

                    <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="NEXUS CORE" FontSize="15" FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                            <Border Style="{StaticResource Pill}" Margin="12,0,0,0"
                                    BorderBrush="{StaticResource BrushCompleted}">
                                <TextBlock Style="{StaticResource PillText}" Text="{Binding CoreStatus}"
                                           Foreground="{StaticResource BrushCompleted}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Style="{StaticResource Muted}" FontSize="10.5" Margin="0,5,0,0">
                            <Run Text="{Binding HostName, Mode=OneWay}" /><Run Text=" &#183; OPERATOR " /><Run Text="{Binding OperatorName, Mode=OneWay}" /><Run Text=" &#183; " /><Run Text="{Binding OperatorRole, Mode=OneWay}" /><Run Text=" &#183; SESSION UPTIME " /><Run Text="{Binding Shell.UptimeDisplay, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel Margin="0,0,22,0">
                            <TextBlock Text="{Binding CpuPercent}" Style="{StaticResource Mono}"
                                       FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Right"
                                       Foreground="{Binding CpuBrushKey, Converter={StaticResource ResBrush}}" />
                            <TextBlock Style="{StaticResource MetricLabel}" HorizontalAlignment="Right"
                                       ctrl:Tracking.Text="CPU" />
                        </StackPanel>
                        <StackPanel Margin="0,0,22,0">
                            <TextBlock Text="{Binding MemoryPercent}" Style="{StaticResource Mono}"
                                       FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Right"
                                       Foreground="{Binding MemoryBrushKey, Converter={StaticResource ResBrush}}" />
                            <TextBlock Style="{StaticResource MetricLabel}" HorizontalAlignment="Right"
                                       ctrl:Tracking.Text="MEMORY" />
                        </StackPanel>
                        <Button Style="{StaticResource BtnPrimary}" Command="{Binding SweepCommand}"
                                Padding="16,9" ToolTip="Poll every subsystem now">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{ctrl:Glyph Refresh}" FontFamily="{StaticResource FontIcon}" FontSize="11"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="RUN SYSTEM CHECK" Margin="8,0,0,0" FontSize="10"
                                           FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ============ SUBSYSTEM TILES ============ -->
            <ItemsControl Grid.Row="1" ItemsSource="{Binding Tiles}" Margin="0,14,0,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="5" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Margin="0,0,12,12" Cursor="Hand" FocusVisualStyle="{x:Null}"
                                Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding SectionKey}"
                                HorizontalContentAlignment="Stretch">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Root" CornerRadius="10" Padding="16,14" BorderThickness="1"
                                            Background="{StaticResource BrushPanelGradient}"
                                            BorderBrush="{StaticResource BrushBorder}">
                                        <Border.RenderTransform>
                                            <TranslateTransform x:Name="Lift" Y="0" />
                                        </Border.RenderTransform>
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Root" Property="BorderBrush"
                                                    Value="{StaticResource BrushAccent}" />
                                            <Trigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="Lift"
                                                                         Storyboard.TargetProperty="Y"
                                                                         To="-3" Duration="0:0:0.15" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.EnterActions>
                                            <Trigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="Lift"
                                                                         Storyboard.TargetProperty="Y"
                                                                         To="0" Duration="0:0:0.15" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.ExitActions>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>

                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="{Binding Label}" Style="{StaticResource SectionLabel}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Glyph, Converter={StaticResource Glyph}}" FontFamily="{StaticResource FontIcon}"
                                               FontSize="12" HorizontalAlignment="Right"
                                               Foreground="{Binding BrushKey, Converter={StaticResource ResBrush}}" />
                                </Grid>

                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Ellipse Width="7" Height="7" VerticalAlignment="Center"
                                             Fill="{Binding BrushKey, Converter={StaticResource ResBrush}}" />
                                    <TextBlock Text="{Binding Value}" FontSize="15" FontWeight="SemiBold"
                                               Margin="8,0,0,0" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" FontSize="10"
                                           Margin="0,7,0,0" TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Detail}" />
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- ============ ENVIRONMENT SPLIT ============ -->
            <Border Grid.Row="2" Style="{StaticResource InsetPanel}" Padding="18,13" Margin="0,14,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Style="{StaticResource PulseDot}" Width="7" Height="7"
                                     Fill="{StaticResource BrushCompleted}" />
                            <TextBlock Style="{StaticResource SectionLabel}" Margin="9,0,0,0"
                                       VerticalAlignment="Center" ctrl:Tracking.Text="REAL ENVIRONMENT" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Muted}" FontSize="10.5" Margin="0,7,0,0">
                            <Run Text="{Binding RealDeviceCount, Mode=OneWay}" /><Run Text=" devices &#183; " /><Run Text="{Binding RealServiceCount, Mode=OneWay}" /><Run Text=" services &#183; this machine's live telemetry" />
                        </TextBlock>
                    </StackPanel>

                    <Border Grid.Column="1" Width="1" Margin="24,2"
                            Background="{StaticResource BrushBorder}" />

                    <StackPanel Grid.Column="2">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Style="{StaticResource PulseDot}" Width="7" Height="7"
                                     Fill="{StaticResource BrushLow}" />
                            <TextBlock Style="{StaticResource SectionLabel}" Margin="9,0,0,0"
                                       VerticalAlignment="Center" ctrl:Tracking.Text="SIMULATION" />
                            <Border Style="{StaticResource Pill}" Margin="10,0,0,0"
                                    BorderBrush="{StaticResource BrushLow}">
                                <TextBlock Style="{StaticResource PillText}" Text="NEXUS CORPORATION"
                                           Foreground="{StaticResource BrushLow}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Style="{StaticResource Muted}" FontSize="10.5" Margin="0,7,0,0">
                            <Run Text="{Binding SimEmployeeCount, Mode=OneWay}" /><Run Text=" employees &#183; " /><Run Text="{Binding SimWorkstationCount, Mode=OneWay}" /><Run Text=" workstations &#183; " /><Run Text="{Binding SimOpenTickets, Mode=OneWay}" /><Run Text=" open tickets" />
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ============ CONNECTED ENVIRONMENT ============ -->
            <Border Grid.Row="3" Style="{StaticResource Panel}" Margin="0,14,0,0">
                <StackPanel>
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Style="{StaticResource PulseDot}"
                                     Fill="{Binding EnvironmentBrushKey, Converter={StaticResource ResBrush}}" />
                            <TextBlock Style="{StaticResource SectionLabel}" Margin="10,0,0,0"
                                       VerticalAlignment="Center" ctrl:Tracking.Text="CONNECTED ENVIRONMENT" />
                            <TextBlock Text="{Binding EnvironmentStatus}" FontSize="11" FontWeight="SemiBold"
                                       Margin="12,0,0,0" VerticalAlignment="Center"
                                       Foreground="{Binding EnvironmentBrushKey, Converter={StaticResource ResBrush}}" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <StackPanel Margin="0,0,20,0">
                                <TextBlock Text="{Binding OnlineDeviceCount}" Style="{StaticResource Mono}"
                                           FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                <TextBlock Style="{StaticResource MetricLabel}" FontSize="7.5"
                                           HorizontalAlignment="Center" ctrl:Tracking.Text="DEVICES" />
                            </StackPanel>
                            <StackPanel Margin="0,0,20,0">
                                <TextBlock Text="{Binding RunningServiceCount}" Style="{StaticResource Mono}"
                                           FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                <TextBlock Style="{StaticResource MetricLabel}" FontSize="7.5"
                                           HorizontalAlignment="Center" ctrl:Tracking.Text="SERVICES" />
                            </StackPanel>
                            <StackPanel Margin="0,0,20,0">
                                <TextBlock Text="{Binding OnlineServerCount}" Style="{StaticResource Mono}"
                                           FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                <TextBlock Style="{StaticResource MetricLabel}" FontSize="7.5"
                                           HorizontalAlignment="Center" ctrl:Tracking.Text="SERVERS" />
                            </StackPanel>
                            <StackPanel Margin="0,0,20,0">
                                <TextBlock Text="{Binding LatencyDisplay}" Style="{StaticResource Mono}"
                                           FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center"
                                           Foreground="{Binding LatencyBrushKey, Converter={StaticResource ResBrush}}" />
                                <TextBlock Style="{StaticResource MetricLabel}" FontSize="7.5"
                                           HorizontalAlignment="Center" ctrl:Tracking.Text="GATEWAY RTT" />
                            </StackPanel>
                            <Button Style="{StaticResource BtnSmallGhost}" Content="NETWORK"
                                    VerticalAlignment="Center"
                                    Command="{Binding OpenCommand}" CommandParameter="NETWORK" />
                        </StackPanel>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding Environment}" Margin="0,14,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Columns="4" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource RowItem}" Margin="0,0,10,10" Padding="14,12"
                                        Command="{Binding DataContext.OpenDeviceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                    <StackPanel>
                                        <Grid>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Glyph, Converter={StaticResource Glyph}}"
                                                           FontFamily="{StaticResource FontIcon}" FontSize="14"
                                                           VerticalAlignment="Center"
                                                           Foreground="{Binding StatusBrushKey, Converter={StaticResource ResBrush}}" />
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource Cell}"
                                                           FontWeight="SemiBold" Margin="10,0,0,0"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <Ellipse Style="{StaticResource PulseDot}" HorizontalAlignment="Right"
                                                     Width="7" Height="7"
                                                     Fill="{Binding StatusBrushKey, Converter={StaticResource ResBrush}}" />
                                        </Grid>

                                        <TextBlock Text="{Binding StatusLabel}" FontSize="9" FontWeight="SemiBold"
                                                   Margin="0,9,0,0"
                                                   Foreground="{Binding StatusBrushKey, Converter={StaticResource ResBrush}}" />
                                        <TextBlock Text="{Binding TypeLabel}" Style="{StaticResource CellDim}"
                                                   FontSize="9.5" Margin="0,3,0,0" />
                                        <TextBlock Text="{Binding AddressDisplay}" Style="{StaticResource CellMono}"
                                                   FontSize="9.5" Margin="0,3,0,0" />
                                        <TextBlock Style="{StaticResource CellDim}" FontSize="9" Margin="0,3,0,0">
                                            <Run Text="LAST SEEN " /><Run Text="{Binding LastSeenDisplay, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock Text="{Binding IntegrationLabel}" FontSize="8" Margin="0,5,0,0"
                                                   Foreground="{Binding IntegrationBrushKey, Converter={StaticResource ResBrush}}" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ============ ALERTS ============ -->
            <Border Grid.Row="4" Style="{StaticResource Panel}" Margin="0,14,0,0"
                    Visibility="{Binding HasAlerts, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{ctrl:Glyph Warning}" FontFamily="{StaticResource FontIcon}" FontSize="12"
                                       VerticalAlignment="Center" Foreground="{StaticResource BrushCritical}" />
                            <TextBlock Style="{StaticResource SectionLabel}" Margin="9,0,0,0"
                                       VerticalAlignment="Center" ctrl:Tracking.Text="ACTIVE ALERTS" />
                            <Border Style="{StaticResource Pill}" Margin="10,0,0,0"
                                    BorderBrush="{StaticResource BrushCritical}">
                                <TextBlock Style="{StaticResource PillText}" Text="{Binding AlertCount}"
                                           Foreground="{StaticResource BrushCritical}" />
                            </Border>
                        </StackPanel>
                        <Button HorizontalAlignment="Right" Style="{StaticResource BtnSmallGhost}"
                                Content="ACKNOWLEDGE ALL" Command="{Binding AcknowledgeAllCommand}" />
                    </Grid>

                    <ItemsControl ItemsSource="{Binding OpenAlerts}" Margin="0,12,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource DataRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Width="3" CornerRadius="2" Margin="0,0,12,0"
                                                Background="{Binding SeverityBrushKey, Converter={StaticResource ResBrush}}" />
                                        <TextBlock Grid.Column="1" Text="{Binding TimeDisplay}" Style="{StaticResource CellMono}" />
                                        <TextBlock Grid.Column="2" Text="{Binding SeverityLabel}" Style="{StaticResource Cell}"
                                                   FontSize="9.5" FontWeight="SemiBold"
                                                   Foreground="{Binding SeverityBrushKey, Converter={StaticResource ResBrush}}" />
                                        <StackPanel Grid.Column="3">
                                            <TextBlock Text="{Binding Title}" Style="{StaticResource Cell}" />
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource CellDim}" />
                                        </StackPanel>
                                        <Button Grid.Column="4" Style="{StaticResource BtnSmallGhost}" Content="ACK"
                                                Command="{Binding DataContext.AcknowledgeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ============ WATCHLIST / OPERATIONS / EVENTS ============ -->
            <Grid Grid.Row="5" Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="300" />
                    <ColumnDefinition Width="*" MinWidth="260" />
                    <ColumnDefinition Width="1.3*" MinWidth="320" />
                </Grid.ColumnDefinitions>

                <!-- Devices -->
                <Border Grid.Column="0" Style="{StaticResource Panel}" Margin="0,0,14,0" VerticalAlignment="Top">
                    <StackPanel>
                        <Grid>
                            <TextBlock Style="{StaticResource SectionLabel}" ctrl:Tracking.Text="DEVICE WATCHLIST" />
                            <Button HorizontalAlignment="Right" Style="{StaticResource BtnSmallGhost}" Content="OPEN"
                                    Command="{Binding OpenCommand}" CommandParameter="DEVICES" />
                        </Grid>

                        <ItemsControl ItemsSource="{Binding WatchList}" Margin="0,12,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource DataRow}" Padding="10,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="{Binding Glyph, Converter={StaticResource Glyph}}"
                                                       FontFamily="{StaticResource FontIcon}" FontSize="13"
                                                       VerticalAlignment="Center" Margin="0,0,12,0"
                                                       Foreground="{Binding StatusBrushKey, Converter={StaticResource ResBrush}}" />

                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource Cell}" />
                                                <TextBlock Style="{StaticResource CellDim}">
                                                    <Run Text="{Binding TypeLabel, Mode=OneWay}" /><Run Text=" &#183; " /><Run Text="{Binding AddressDisplay, Mode=OneWay}" />
                                                </TextBlock>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding StatusLabel}" FontSize="9.5"
                                                           FontWeight="SemiBold" HorizontalAlignment="Right"
                                                           Foreground="{Binding StatusBrushKey, Converter={StaticResource ResBrush}}" />
                                                <TextBlock Text="{Binding LastSeenDisplay}" Style="{StaticResource CellDim}"
                                                           FontSize="9.5" HorizontalAlignment="Right" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Active operations -->
                <Border Grid.Column="1" Style="{StaticResource Panel}" Margin="0,0,14,0" VerticalAlignment="Top">
                    <StackPanel>
                        <Grid>
                            <TextBlock Style="{StaticResource SectionLabel}" ctrl:Tracking.Text="ACTIVE OPERATIONS" />
                            <Button HorizontalAlignment="Right" Style="{StaticResource BtnSmallGhost}" Content="OPEN"
                                    Command="{Binding OpenCommand}" CommandParameter="SERVERS" />
                        </Grid>

                        <ItemsControl ItemsSource="{Binding ActiveOperations}" Margin="0,12,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource DataRow}" Padding="10,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Ellipse Grid.Column="0" Width="7" Height="7" Margin="0,0,12,0"
                                                     VerticalAlignment="Center"
                                                     Fill="{Binding StateBrushKey, Converter={StaticResource ResBrush}}" />

                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource Cell}" />
                                                <TextBlock Text="{Binding Description}" Style="{StaticResource CellDim}" />
                                            </StackPanel>

                                            <TextBlock Grid.Column="2" Text="{Binding UptimeDisplay}"
                                                       Style="{StaticResource CellMono}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="No services are running." Style="{StaticResource Muted}" Margin="0,10,0,0"
                                   Visibility="{Binding ActiveOperations.Count, Converter={StaticResource CountToVisInv}}" />
                    </StackPanel>
                </Border>

                <!-- Event feed -->
                <Border Grid.Column="2" Style="{StaticResource Panel}" VerticalAlignment="Top">
                    <StackPanel>
                        <Grid>
                            <TextBlock Style="{StaticResource SectionLabel}" ctrl:Tracking.Text="RECENT EVENTS" />
                            <Button HorizontalAlignment="Right" Style="{StaticResource BtnSmallGhost}" Content="AUDIT LOG"
                                    Command="{Binding OpenCommand}" CommandParameter="LOGS" />
                        </Grid>

                        <ItemsControl ItemsSource="{Binding RecentEvents}" Margin="0,12,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,11">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="66" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="82" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding TimeDisplay}"
                                                   Style="{StaticResource CellMono}" VerticalAlignment="Top" />

                                        <Border Grid.Column="1" Width="2" Margin="8,3,10,0" CornerRadius="1"
                                                Background="{Binding CategoryBrushKey, Converter={StaticResource ResBrush}}" />

                                        <TextBlock Grid.Column="2" Text="{Binding CategoryLabel}" FontSize="9"
                                                   FontWeight="SemiBold" VerticalAlignment="Top" Margin="0,1,0,0"
                                                   Foreground="{Binding CategoryBrushKey, Converter={StaticResource ResBrush}}" />

                                        <StackPanel Grid.Column="3">
                                            <TextBlock Text="{Binding Message}" FontSize="11.5"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource CellDim}"
                                                       TextTrimming="CharacterEllipsis" Margin="0,2,0,0"
                                                       Visibility="{Binding Detail, Converter={StaticResource StrToVis}}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
