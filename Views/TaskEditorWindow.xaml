<Window x:Class="NEXUS.Views.TaskEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="clr-namespace:NEXUS.Controls"
        Title="NEXUS"
        Width="620" SizeToContent="Height" MaxHeight="880"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        UseLayoutRounding="True">

    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}" />
    </Window.InputBindings>

    <Border Background="{StaticResource BrushWindow}" BorderBrush="{StaticResource BrushBorder}"
            BorderThickness="1" CornerRadius="12" Margin="16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="32" ShadowDepth="8" Opacity="0.65" Color="#000000" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Background="Transparent" Margin="22,18,14,0"
                  MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionLabel}" Text="{Binding Heading}" />
                    <TextBlock Text="Define the work item and how it should be tracked."
                               Style="{StaticResource Muted}" FontSize="10.5" Margin="0,4,0,0" />
                </StackPanel>
                <Button Style="{StaticResource BtnIcon}" Content="{ctrl:Glyph Close}" FontSize="9"
                        HorizontalAlignment="Right" VerticalAlignment="Top"
                        Command="{Binding CancelCommand}" />
            </Grid>

            <!-- Body -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,16,0,0" Padding="22,0,14,0">
                <StackPanel>

                    <TextBlock Text="TASK NAME" Style="{StaticResource SectionLabel}" />
                    <TextBox Style="{StaticResource Input}" Margin="0,8,0,0" FontSize="14"
                             Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="PRIORITY" Style="{StaticResource SectionLabel}" Margin="0,18,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <ToggleButton Style="{StaticResource Chip}" Content="CRITICAL"
                                      IsChecked="{Binding PriorityKey, Converter={StaticResource EqBool}, ConverterParameter=Critical, Mode=OneWay}"
                                      Command="{Binding SetPriorityCommand}" CommandParameter="Critical" />
                        <ToggleButton Style="{StaticResource Chip}" Content="HIGH"
                                      IsChecked="{Binding PriorityKey, Converter={StaticResource EqBool}, ConverterParameter=High, Mode=OneWay}"
                                      Command="{Binding SetPriorityCommand}" CommandParameter="High" />
                        <ToggleButton Style="{StaticResource Chip}" Content="NORMAL"
                                      IsChecked="{Binding PriorityKey, Converter={StaticResource EqBool}, ConverterParameter=Normal, Mode=OneWay}"
                                      Command="{Binding SetPriorityCommand}" CommandParameter="Normal" />
                        <ToggleButton Style="{StaticResource Chip}" Content="LOW"
                                      IsChecked="{Binding PriorityKey, Converter={StaticResource EqBool}, ConverterParameter=Low, Mode=OneWay}"
                                      Command="{Binding SetPriorityCommand}" CommandParameter="Low" />
                    </StackPanel>

                    <TextBlock Text="STATUS" Style="{StaticResource SectionLabel}" Margin="0,18,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <ToggleButton Style="{StaticResource Chip}" Content="PLANNED"
                                      IsChecked="{Binding StateKey, Converter={StaticResource EqBool}, ConverterParameter=Planned, Mode=OneWay}"
                                      Command="{Binding SetStateCommand}" CommandParameter="Planned" />
                        <ToggleButton Style="{StaticResource Chip}" Content="IN PROGRESS"
                                      IsChecked="{Binding StateKey, Converter={StaticResource EqBool}, ConverterParameter=InProgress, Mode=OneWay}"
                                      Command="{Binding SetStateCommand}" CommandParameter="InProgress" />
                        <ToggleButton Style="{StaticResource Chip}" Content="BLOCKED"
                                      IsChecked="{Binding StateKey, Converter={StaticResource EqBool}, ConverterParameter=Blocked, Mode=OneWay}"
                                      Command="{Binding SetStateCommand}" CommandParameter="Blocked" />
                        <ToggleButton Style="{StaticResource Chip}" Content="COMPLETED"
                                      IsChecked="{Binding StateKey, Converter={StaticResource EqBool}, ConverterParameter=Completed, Mode=OneWay}"
                                      Command="{Binding SetStateCommand}" CommandParameter="Completed" />
                    </StackPanel>

                    <!-- Deadline -->
                    <TextBlock Text="DEADLINE" Style="{StaticResource SectionLabel}" Margin="0,18,0,0" />
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Style="{StaticResource Input}" Margin="0,0,10,0"
                                 Text="{Binding DateText, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="YYYY-MM-DD, or leave blank for no deadline" />
                        <TextBox Grid.Column="1" Style="{StaticResource Input}"
                                 Text="{Binding TimeText, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="HH:MM" />
                        <Button Grid.Column="2" Style="{StaticResource BtnIcon}" Content="{ctrl:Glyph Cancel}" Margin="8,0,0,0"
                                ToolTip="Clear the deadline" Command="{Binding ClearDeadlineCommand}" />
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Style="{StaticResource BtnGhost}" Content="TODAY" Padding="12,6" FontSize="9.5"
                                Margin="0,0,6,0" Command="{Binding QuickDateCommand}" CommandParameter="TODAY" />
                        <Button Style="{StaticResource BtnGhost}" Content="TOMORROW" Padding="12,6" FontSize="9.5"
                                Margin="0,0,6,0" Command="{Binding QuickDateCommand}" CommandParameter="TOMORROW" />
                        <Button Style="{StaticResource BtnGhost}" Content="WEDNESDAY" Padding="12,6" FontSize="9.5"
                                Margin="0,0,6,0" Command="{Binding QuickDateCommand}" CommandParameter="WEDNESDAY" />
                        <Button Style="{StaticResource BtnGhost}" Content="MISSION DEADLINE" Padding="12,6" FontSize="9.5"
                                Command="{Binding QuickDateCommand}" CommandParameter="MISSION" />
                    </StackPanel>

                    <TextBlock Text="{Binding DeadlinePreview}" Style="{StaticResource Mono}" FontSize="10.5"
                               Margin="0,10,0,0" Foreground="{StaticResource BrushAccent}" />

                    <!-- Notes -->
                    <TextBlock Text="NOTES" Style="{StaticResource SectionLabel}" Margin="0,18,0,0" />
                    <TextBox Style="{StaticResource InputMulti}" Margin="0,8,0,0" Height="76"
                             Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" />

                    <!-- Subtasks -->
                    <TextBlock Text="SUBTASKS" Style="{StaticResource SectionLabel}" Margin="0,18,0,0" />
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Style="{StaticResource Input}" Margin="0,0,10,0"
                                 Text="{Binding NewSubTask, UpdateSourceTrigger=PropertyChanged}"
                                 KeyDown="SubTask_KeyDown" />
                        <Button Grid.Column="1" Style="{StaticResource Btn}" Content="ADD" Padding="16,8"
                                Command="{Binding AddSubTaskCommand}" />
                    </Grid>

                    <ItemsControl ItemsSource="{Binding SubTasks}" Margin="0,10,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource InsetPanel}" Padding="12,8" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Grid.Column="0" Style="{StaticResource Check}"
                                                  IsChecked="{Binding IsDone}" Content="{Binding Title}"
                                                  VerticalAlignment="Center" />
                                        <Button Grid.Column="1" Style="{StaticResource BtnIcon}" Width="24" Height="24"
                                                Content="{ctrl:Glyph Cancel}" FontSize="9"
                                                Command="{Binding DataContext.RemoveSubTaskCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Progress -->
                    <TextBlock Text="PROGRESS" Style="{StaticResource SectionLabel}" Margin="0,18,0,0" />
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Slider Grid.Column="0" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"
                                VerticalAlignment="Center" Value="{Binding Progress}" />
                        <TextBlock Grid.Column="1" Style="{StaticResource Mono}" FontSize="12" Margin="14,0,0,0"
                                   VerticalAlignment="Center"
                                   Text="{Binding Progress, StringFormat={}{0}%}" />
                    </Grid>
                    <TextBlock Text="Progress is calculated automatically when subtasks are present."
                               Style="{StaticResource Muted}" FontSize="10" Margin="0,8,0,0" />
                </StackPanel>
            </ScrollViewer>

            <!-- Footer -->
            <Border Grid.Row="2" Margin="22,18,22,18">
                <Grid>
                    <TextBlock Text="{Binding Error}" FontSize="10.5" FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource BrushCritical}"
                               Visibility="{Binding Error, Converter={StaticResource StrToVis}}" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource BtnGhost}" Content="CANCEL" Padding="20,9"
                                Command="{Binding CancelCommand}" />
                        <Button Style="{StaticResource BtnPrimary}" Content="SAVE TASK" Padding="24,9"
                                Margin="10,0,0,0" IsDefault="True" Command="{Binding SaveCommand}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
