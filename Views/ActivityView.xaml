<UserControl x:Class="NEXUS.Views.ActivityView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:NEXUS.Controls">

    <Grid Margin="28,0,20,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ================= TOOLBAR ================= -->
        <Border Grid.Row="0" Style="{StaticResource Panel}" Padding="16" Margin="0,0,8,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <ToggleButton Style="{StaticResource Chip}" Content="ALL"
                                  IsChecked="{Binding Filter, Converter={StaticResource EqBool}, ConverterParameter=ALL, Mode=OneWay}"
                                  Command="{Binding SetFilterCommand}" CommandParameter="ALL" />
                    <ToggleButton Style="{StaticResource Chip}" Content="TASKS"
                                  IsChecked="{Binding Filter, Converter={StaticResource EqBool}, ConverterParameter=TASKS, Mode=OneWay}"
                                  Command="{Binding SetFilterCommand}" CommandParameter="TASKS" />
                    <ToggleButton Style="{StaticResource Chip}" Content="STATUS"
                                  IsChecked="{Binding Filter, Converter={StaticResource EqBool}, ConverterParameter=STATUS, Mode=OneWay}"
                                  Command="{Binding SetFilterCommand}" CommandParameter="STATUS" />
                    <ToggleButton Style="{StaticResource Chip}" Content="FOCUS"
                                  IsChecked="{Binding Filter, Converter={StaticResource EqBool}, ConverterParameter=FOCUS, Mode=OneWay}"
                                  Command="{Binding SetFilterCommand}" CommandParameter="FOCUS" />
                    <ToggleButton Style="{StaticResource Chip}" Content="SYSTEM"
                                  IsChecked="{Binding Filter, Converter={StaticResource EqBool}, ConverterParameter=SYSTEM, Mode=OneWay}"
                                  Command="{Binding SetFilterCommand}" CommandParameter="SYSTEM" />
                </StackPanel>

                <Grid Grid.Column="1" MaxWidth="300" HorizontalAlignment="Right" Margin="14,0,14,0">
                    <TextBox Style="{StaticResource Input}" Padding="34,8,10,8"
                             Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=120}" />
                    <TextBlock Text="{ctrl:Glyph Search}" FontFamily="{StaticResource FontIcon}" FontSize="12"
                               Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                               Foreground="{StaticResource BrushTextMuted}" />
                    <TextBlock Text="Search the log" IsHitTestVisible="False" FontSize="12.5"
                               Margin="34,0,0,0" VerticalAlignment="Center"
                               Foreground="{StaticResource BrushTextMuted}"
                               Visibility="{Binding Search, Converter={StaticResource StrToVisInv}}" />
                </Grid>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource Caption}" FontWeight="SemiBold" VerticalAlignment="Center"
                               Margin="0,0,14,0">
                        <Run Text="{Binding Count, Mode=OneWay}" /><Run Text=" ENTRIES" />
                    </TextBlock>
                    <Button Style="{StaticResource BtnDanger}" Content="CLEAR" Padding="14,7"
                            Command="{Binding ClearCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= LOG ================= -->
        <Border Grid.Row="1" Style="{StaticResource Panel}" Margin="0,14,8,0" Padding="0">
            <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18,16,10,16">
                    <ItemsControl ItemsSource="{Binding Entries}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="88" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="{Binding DateDisplay}"
                                               Style="{StaticResource Mono}" FontSize="10"
                                               Foreground="{StaticResource BrushTextMuted}"
                                               VerticalAlignment="Center" Width="52" />

                                    <TextBlock Grid.Column="1" Text="{Binding TimeDisplay}"
                                               Style="{StaticResource Mono}" FontSize="11"
                                               Foreground="{StaticResource BrushTextDim}"
                                               VerticalAlignment="Center" Margin="0,0,14,0" />

                                    <Border Grid.Column="2" Width="2" Margin="0,6,14,6" CornerRadius="1"
                                            Background="{Binding Kind, Converter={StaticResource ActivityBrush}}" />

                                    <TextBlock Grid.Column="3" Text="{Binding KindLabel}" FontSize="9.5"
                                               FontWeight="SemiBold" VerticalAlignment="Center"
                                               Foreground="{Binding Kind, Converter={StaticResource ActivityBrush}}" />

                                    <StackPanel Grid.Column="4" Margin="0,9,0,9">
                                        <TextBlock Text="{Binding Message}" FontSize="12" />
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}"
                                                   FontSize="10.5" TextWrapping="Wrap" Margin="0,3,0,0"
                                                   Visibility="{Binding Detail, Converter={StaticResource StrToVis}}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{ctrl:Glyph Activity}" FontFamily="{StaticResource FontIcon}" FontSize="26"
                               HorizontalAlignment="Center" Foreground="{StaticResource BrushTextMuted}" />
                    <TextBlock Text="NO ACTIVITY MATCHES THIS FILTER" FontSize="12" FontWeight="SemiBold"
                               Margin="0,14,0,0" HorizontalAlignment="Center" />
                    <TextBlock Text="Operations are recorded here automatically as you work."
                               Style="{StaticResource Muted}" Margin="0,6,0,0" HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
