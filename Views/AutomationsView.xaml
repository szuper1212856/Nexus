<UserControl x:Class="NEXUS.Views.AutomationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:NEXUS.Controls">

    <Grid Margin="28,0,20,24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="480" />
            <ColumnDefinition Width="330" />
        </Grid.ColumnDefinitions>

        <!-- ================= RULES ================= -->
        <Grid Grid.Column="0" Margin="0,0,14,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource Panel}" Padding="18,14">
                <UniformGrid Columns="3">
                    <StackPanel>
                        <TextBlock Text="{Binding RuleCount}" Style="{StaticResource MetricValue}" FontSize="20" />
                        <TextBlock Style="{StaticResource MetricLabel}" ctrl:Tracking.Text="RULES" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="{Binding EnabledCount}" Style="{StaticResource MetricValue}" FontSize="20"
                                   Foreground="{StaticResource BrushCompleted}" />
                        <TextBlock Style="{StaticResource MetricLabel}" ctrl:Tracking.Text="ARMED" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="{Binding TotalFired}" Style="{StaticResource MetricValue}" FontSize="20" />
                        <TextBlock Style="{StaticResource MetricLabel}" ctrl:Tracking.Text="TIMES TRIGGERED" />
                    </StackPanel>
                </UniformGrid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,14,0,0">
                <ItemsControl ItemsSource="{Binding Rules}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Panel}" Margin="0,0,6,12" Padding="18,16">
                                <StackPanel>
                                    <Grid>
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                                     Fill="{Binding StateBrushKey, Converter={StaticResource ResBrush}}" />
                                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                                       Margin="10,0,0,0" VerticalAlignment="Center" />
                                            <Border Style="{StaticResource Pill}" Margin="10,0,0,0"
                                                    BorderBrush="{Binding StateBrushKey, Converter={StaticResource ResBrush}}">
                                                <TextBlock Style="{StaticResource PillText}" Text="{Binding StateLabel}"
                                                           Foreground="{Binding StateBrushKey, Converter={StaticResource ResBrush}}" />
                                            </Border>
                                            <Border Style="{StaticResource Pill}" Margin="8,0,0,0"
                                                    BorderBrush="{StaticResource BrushBorder}"
                                                    Visibility="{Binding IsBuiltIn, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Style="{StaticResource PillText}" Text="BUILT-IN"
                                                           Foreground="{StaticResource BrushTextMuted}" />
                                            </Border>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Style="{StaticResource BtnSmallGhost}" Content="TOGGLE"
                                                    Command="{Binding DataContext.ToggleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Style="{StaticResource BtnSmallGhost}" Content="DELETE"
                                                    Margin="8,0,0,0"
                                                    Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- WHEN / IF / THEN -->
                                    <Grid Margin="0,16,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Style="{StaticResource InsetPanel}" Padding="12,10">
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource SectionLabel}"
                                                           Foreground="{StaticResource BrushAccent}"
                                                           ctrl:Tracking.Text="WHEN" />
                                                <TextBlock Text="{Binding TriggerLabel}" Style="{StaticResource Cell}"
                                                           FontSize="11" TextWrapping="Wrap" Margin="0,7,0,0" />
                                            </StackPanel>
                                        </Border>

                                        <TextBlock Grid.Column="1" Text="&#x2192;" FontSize="13" Margin="10,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="{StaticResource BrushTextMuted}" />

                                        <Border Grid.Column="2" Style="{StaticResource InsetPanel}" Padding="12,10">
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource SectionLabel}"
                                                           Foreground="{StaticResource BrushHigh}"
                                                           ctrl:Tracking.Text="IF" />
                                                <TextBlock Text="{Binding ConditionLabel}" Style="{StaticResource Cell}"
                                                           FontSize="11" TextWrapping="Wrap" Margin="0,7,0,0" />
                                            </StackPanel>
                                        </Border>

                                        <TextBlock Grid.Column="3" Text="&#x2192;" FontSize="13" Margin="10,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="{StaticResource BrushTextMuted}" />

                                        <Border Grid.Column="4" Style="{StaticResource InsetPanel}" Padding="12,10">
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource SectionLabel}"
                                                           Foreground="{StaticResource BrushCompleted}"
                                                           ctrl:Tracking.Text="THEN" />
                                                <TextBlock Text="{Binding ActionLabel}" Style="{StaticResource Cell}"
                                                           FontSize="11" TextWrapping="Wrap" Margin="0,7,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <TextBlock Style="{StaticResource CellDim}" Margin="0,12,0,0">
                                        <Run Text="TRIGGERED " /><Run Text="{Binding TimesFired, Mode=OneWay}" /><Run Text="&#215; &#183; LAST " /><Run Text="{Binding LastFiredDisplay, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- ================= NEW RULE ================= -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
            <StackPanel>
                <Border Style="{StaticResource Panel}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionLabel}" ctrl:Tracking.Text="CREATE AUTOMATION" />

                        <TextBlock Style="{StaticResource SectionLabel}" Margin="0,16,0,0" ctrl:Tracking.Text="NAME" />
                        <TextBox Style="{StaticResource Input}" Margin="0,6,0,0"
                                 Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Style="{StaticResource SectionLabel}" Margin="0,14,0,0"
                                   Foreground="{StaticResource BrushAccent}" ctrl:Tracking.Text="WHEN" />
                        <ComboBox Style="{StaticResource Combo}" Margin="0,6,0,0"
                                  ItemsSource="{Binding Triggers}" SelectedItem="{Binding NewTrigger}" />

                        <TextBlock Style="{StaticResource SectionLabel}" Margin="0,14,0,0"
                                   Foreground="{StaticResource BrushHigh}" ctrl:Tracking.Text="IF SUBJECT CONTAINS" />
                        <TextBox Style="{StaticResource Input}" Margin="0,6,0,0"
                                 Text="{Binding NewCondition, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Leave empty to match any subject" />
                        <TextBlock Style="{StaticResource Muted}" FontSize="9.5" Margin="0,5,0,0"
                                   Text="Leave empty to match any device, service or account." />

                        <TextBlock Style="{StaticResource SectionLabel}" Margin="0,14,0,0"
                                   Foreground="{StaticResource BrushCompleted}" ctrl:Tracking.Text="THEN" />
                        <ComboBox Style="{StaticResource Combo}" Margin="0,6,0,0"
                                  ItemsSource="{Binding Actions}" SelectedItem="{Binding NewAction}" />

                        <Button Style="{StaticResource BtnPrimary}" Content="ARM AUTOMATION" Margin="0,18,0,0"
                                Padding="16,10" HorizontalAlignment="Stretch"
                                Command="{Binding CreateCommand}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource InsetPanel}" Padding="14,12" Margin="0,14,0,0">
                    <TextBlock Style="{StaticResource Muted}" FontSize="10" TextWrapping="Wrap"
                               Text="Rules react to real NEXUS events: device and server state changes, service stops, account suspensions, permission changes and task completions. Built-in rules can be disarmed but not deleted." />
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
