<UserControl x:Class="NEXUS.Views.SecurityView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:NEXUS.Controls">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,0,20,24">
        <Grid Margin="0,0,8,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ============ POSTURE ============ -->
            <Border Grid.Row="0" Style="{StaticResource Panel}" Padding="20,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="46" Height="46" CornerRadius="10"
                            Background="{StaticResource BrushPanelAlt}" BorderThickness="1"
                            BorderBrush="{Binding PostureBrushKey, Converter={StaticResource ResBrush}}">
                        <TextBlock Text="{ctrl:Glyph Security}" FontFamily="{StaticResource FontIcon}" FontSize="19"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{Binding PostureBrushKey, Converter={StaticResource ResBrush}}" />
                    </Border>

                    <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="SECURITY POSTURE" Style="{StaticResource SectionLabel}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{Binding PostureLabel}" FontSize="15" FontWeight="SemiBold"
                                       Margin="12,0,0,0" VerticalAlignment="Center"
                                       Foreground="{Binding PostureBrushKey, Converter={StaticResource ResBrush}}" />
                        </StackPanel>
                        <TextBlock Text="{Binding PostureDetail}" Style="{StaticResource Muted}"
                                   FontSize="10.5" Margin="0,6,0,0" TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel Margin="0,0,24,0">
                            <TextBlock Text="{Binding OpenAlerts}" Style="{StaticResource MetricValue}"
                                       FontSize="20" HorizontalAlignment="Right" />
                            <TextBlock Style="{StaticResource MetricLabel}" HorizontalAlignment="Right"
                                       ctrl:Tracking.Text="OPEN ALERTS" />
                        </StackPanel>
                        <StackPanel Margin="0,0,24,0">
                            <TextBlock Text="{Binding ActiveSessions}" Style="{StaticResource MetricValue}"
                                       FontSize="20" HorizontalAlignment="Right" />
                            <TextBlock Style="{StaticResource MetricLabel}" HorizontalAlignment="Right"
                                       ctrl:Tracking.Text="SESSIONS" />
                        </StackPanel>
                        <StackPanel Margin="0,0,24,0">
                            <TextBlock Text="{Binding SuspendedUsers}" Style="{StaticResource MetricValue}"
                                       FontSize="20" HorizontalAlignment="Right" />
                            <TextBlock Style="{StaticResource MetricLabel}" HorizontalAlignment="Right"
                                       ctrl:Tracking.Text="SUSPENDED" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="{Binding CriticalEvents}" Style="{StaticResource MetricValue}"
                                       FontSize="20" HorizontalAlignment="Right" />
                            <TextBlock Style="{StaticResource MetricLabel}" HorizontalAlignment="Right"
                                       ctrl:Tracking.Text="CRITICAL 24H" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ============ ALERTS ============ -->
            <Border Grid.Row="1" Style="{StaticResource Panel}" Margin="0,14,0,0">
                <StackPanel>
                    <Grid>
                        <TextBlock Style="{StaticResource SectionLabel}" ctrl:Tracking.Text="SYSTEM ALERTS" />
                        <Button HorizontalAlignment="Right" Style="{StaticResource BtnSmallGhost}"
                                Content="ACKNOWLEDGE ALL" Command="{Binding AcknowledgeAllCommand}" />
                    </Grid>

                    <ItemsControl ItemsSource="{Binding Alerts}" Margin="0,12,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource DataRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="72" />
                                            <ColumnDefinition Width="86" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Width="3" CornerRadius="2" Margin="0,0,12,0"
                                                Background="{Binding SeverityBrushKey, Converter={StaticResource ResBrush}}" />
                                        <TextBlock Grid.Column="1" Text="{Binding TimeDisplay}"
                                                   Style="{StaticResource CellMono}" />
                                        <TextBlock Grid.Column="2" Text="{Binding SeverityLabel}" FontSize="9.5"
                                                   FontWeight="SemiBold" VerticalAlignment="Center"
                                                   Foreground="{Binding SeverityBrushKey, Converter={StaticResource ResBrush}}" />
                                        <StackPanel Grid.Column="3" Margin="0,0,10,0">
                                            <TextBlock Text="{Binding Title}" Style="{StaticResource Cell}" />
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource CellDim}" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="4" Orientation="Horizontal">
                                            <Border Style="{StaticResource Pill}"
                                                    BorderBrush="{StaticResource BrushCompleted}" Margin="0,0,8,0"
                                                    Visibility="{Binding Acknowledged, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Style="{StaticResource PillText}" Text="ACKNOWLEDGED"
                                                           Foreground="{StaticResource BrushCompleted}" />
                                            </Border>
                                            <Button Style="{StaticResource BtnSmallGhost}" Content="ACK"
                                                    Visibility="{Binding Acknowledged, Converter={StaticResource BoolToVisInv}}"
                                                    Command="{Binding DataContext.AcknowledgeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="No alerts have been raised." Style="{StaticResource Muted}" Margin="0,10,0,0"
                               Visibility="{Binding Alerts.Count, Converter={StaticResource CountToVisInv}}" />
                </StackPanel>
            </Border>

            <!-- ============ SESSIONS / SUSPENDED / AUTH TRAIL ============ -->
            <Grid Grid.Row="2" Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="320" />
                    <ColumnDefinition Width="1.2*" MinWidth="360" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,14,0">
                    <Border Style="{StaticResource Panel}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionLabel}" ctrl:Tracking.Text="ACTIVE SESSIONS" />

                            <ItemsControl ItemsSource="{Binding Sessions}" Margin="0,12,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource DataRow}" Padding="10,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <Border Grid.Column="0" Width="28" Height="28" CornerRadius="14"
                                                        Background="{StaticResource BrushPanelAlt}"
                                                        BorderThickness="1"
                                                        BorderBrush="{Binding RoleBrushKey, Converter={StaticResource ResBrush}}">
                                                    <TextBlock Text="{Binding Initials}" FontSize="10"
                                                               FontWeight="SemiBold" HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               Foreground="{Binding RoleBrushKey, Converter={StaticResource ResBrush}}" />
                                                </Border>

                                                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                                    <TextBlock Text="{Binding DisplayName}" Style="{StaticResource Cell}" />
                                                    <TextBlock Style="{StaticResource CellDim}">
                                                        <Run Text="{Binding RoleLabel, Mode=OneWay}" /><Run Text=" &#183; " /><Run Text="{Binding SessionCount, Mode=OneWay}" /><Run Text=" SESSION(S)" />
                                                    </TextBlock>
                                                </StackPanel>

                                                <Button Grid.Column="2" Style="{StaticResource BtnSmallGhost}"
                                                        Content="REVOKE"
                                                        Command="{Binding DataContext.RevokeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="No sessions are open." Style="{StaticResource Muted}" Margin="0,10,0,0"
                                       Visibility="{Binding Sessions.Count, Converter={StaticResource CountToVisInv}}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Panel}" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionLabel}" ctrl:Tracking.Text="SUSPENDED ACCOUNTS" />

                            <ItemsControl ItemsSource="{Binding Suspended}" Margin="0,12,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource DataRow}" Padding="10,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding DisplayName}" Style="{StaticResource Cell}" />
                                                    <TextBlock Text="{Binding AccessLevel}" Style="{StaticResource CellDim}" />
                                                </StackPanel>
                                                <Button Grid.Column="1" Style="{StaticResource BtnSmallGhost}"
                                                        Content="REINSTATE"
                                                        Command="{Binding DataContext.ReinstateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="No accounts are suspended." Style="{StaticResource Muted}" Margin="0,10,0,0"
                                       Visibility="{Binding Suspended.Count, Converter={StaticResource CountToVisInv}}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Auth trail -->
                <Border Grid.Column="1" Style="{StaticResource Panel}" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionLabel}"
                                   ctrl:Tracking.Text="AUTHENTICATION &amp; ACCESS TRAIL" />

                        <ItemsControl ItemsSource="{Binding AuthTrail}" Margin="0,12,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,11">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="66" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="74" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding TimeDisplay}"
                                                   Style="{StaticResource CellMono}" VerticalAlignment="Top" />
                                        <Border Grid.Column="1" Width="2" Margin="8,3,10,0" CornerRadius="1"
                                                Background="{Binding CategoryBrushKey, Converter={StaticResource ResBrush}}" />
                                        <TextBlock Grid.Column="2" Text="{Binding CategoryLabel}" FontSize="9"
                                                   FontWeight="SemiBold" VerticalAlignment="Top" Margin="0,1,0,0"
                                                   Foreground="{Binding CategoryBrushKey, Converter={StaticResource ResBrush}}" />
                                        <StackPanel Grid.Column="3">
                                            <TextBlock Text="{Binding Message}" FontSize="11.5" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource CellDim}"
                                                       TextWrapping="Wrap" Margin="0,2,0,0"
                                                       Visibility="{Binding Detail, Converter={StaticResource StrToVis}}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
