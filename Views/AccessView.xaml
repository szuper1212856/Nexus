<UserControl x:Class="NEXUS.Views.AccessView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:NEXUS.Controls">

    <Grid Margin="28,0,20,24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="520" />
            <ColumnDefinition Width="330" />
        </Grid.ColumnDefinitions>

        <!-- ================= MATRIX ================= -->
        <Grid Grid.Column="0" Margin="0,0,14,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource Panel}" Padding="18,14">
                <Grid>
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionLabel}" ctrl:Tracking.Text="ACCESS POLICY MATRIX" />
                        <TextBlock Style="{StaticResource Muted}" FontSize="10.5" Margin="0,6,0,0"
                                   Text="Rows are capabilities, columns are accounts. Every change is written to the audit trail." />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                 Fill="{Binding AuthorityBrushKey, Converter={StaticResource ResBrush}}" />
                        <TextBlock Text="{Binding AuthorityLabel}" FontSize="10" FontWeight="SemiBold"
                                   Margin="9,0,0,0" VerticalAlignment="Center"
                                   Foreground="{Binding AuthorityBrushKey, Converter={StaticResource ResBrush}}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource Panel}" Margin="0,14,0,0" Padding="14,14,8,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Column headers: one per account -->
                    <Border Grid.Row="0" Style="{StaticResource TableHeaderBar}" Margin="0,0,6,6" Padding="12,9">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.6*" MinWidth="180" />
                                <ColumnDefinition Width="3*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Style="{StaticResource ColHead}" ctrl:Tracking.Text="CAPABILITY"
                                       VerticalAlignment="Bottom" />

                            <ItemsControl Grid.Column="1" ItemsSource="{Binding Columns}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="1" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="2,0" HorizontalAlignment="Center">
                                            <Border Width="26" Height="26" CornerRadius="13"
                                                    HorizontalAlignment="Center"
                                                    Background="{StaticResource BrushPanel}" BorderThickness="1"
                                                    BorderBrush="{Binding RoleBrushKey, Converter={StaticResource ResBrush}}">
                                                <TextBlock Text="{Binding Initials}" FontSize="9.5"
                                                           FontWeight="SemiBold" HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Foreground="{Binding RoleBrushKey, Converter={StaticResource ResBrush}}" />
                                            </Border>
                                            <TextBlock Text="{Binding DisplayName}" FontSize="9" Margin="0,5,0,0"
                                                       HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                       Foreground="{StaticResource BrushTextDim}"
                                                       ToolTip="{Binding RoleLabel}" />
                                            <TextBlock Text="{Binding RoleLabel}" FontSize="7.5" Margin="0,2,0,0"
                                                       HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                       Foreground="{Binding RoleBrushKey, Converter={StaticResource ResBrush}}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Rows}" Margin="0,0,6,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource DataRow}" Padding="12,4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.6*" MinWidth="180" />
                                                <ColumnDefinition Width="3*" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="{Binding Label}"
                                                       Style="{StaticResource Cell}" Margin="0,0,10,0" />

                                            <ItemsControl Grid.Column="1" ItemsSource="{Binding Cells}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <UniformGrid Rows="1" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Style="{StaticResource MatrixCell}"
                                                                Command="{Binding DataContext.ToggleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}">
                                                            <Button.ToolTip>
                                                                <TextBlock>
                                                                    <Run Text="{Binding User.DisplayName, Mode=OneWay}" /><Run Text=" &#183; click to toggle" />
                                                                </TextBlock>
                                                            </Button.ToolTip>
                                                            <TextBlock Text="{Binding Mark}" FontSize="13"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{Binding IsAllowed, Converter={StaticResource BoolBrush}}" />
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- ================= RECEIPT + ROLE DEFAULTS ================= -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
            <StackPanel>

                <!-- Policy change receipt -->
                <Border Style="{StaticResource Panel}"
                        Visibility="{Binding HasReceipt, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{ctrl:Glyph Check}" FontFamily="{StaticResource FontIcon}" FontSize="13"
                                       VerticalAlignment="Center" Foreground="{StaticResource BrushCompleted}" />
                            <TextBlock Style="{StaticResource SectionLabel}" Margin="10,0,0,0"
                                       VerticalAlignment="Center" ctrl:Tracking.Text="ACCESS POLICY UPDATED" />
                        </StackPanel>

                        <Border Style="{StaticResource Divider}" Margin="0,14,0,14" />

                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Style="{StaticResource SectionLabel}" ctrl:Tracking.Text="USER" />
                            <TextBlock Text="{Binding LastChange.UserName}" Style="{StaticResource Cell}"
                                       FontWeight="SemiBold" Margin="0,4,0,0" />
                        </StackPanel>

                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Style="{StaticResource SectionLabel}" ctrl:Tracking.Text="PERMISSION" />
                            <TextBlock Text="{Binding LastChange.PermissionName}" Style="{StaticResource Cell}"
                                       Margin="0,4,0,0" />
                        </StackPanel>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource SectionLabel}" ctrl:Tracking.Text="PREVIOUS" />
                                <TextBlock Text="{Binding LastChange.Previous}" Style="{StaticResource CellMono}"
                                           Margin="0,4,0,0" />
                            </StackPanel>

                            <TextBlock Grid.Column="1" Text="&#x2192;" FontSize="14" VerticalAlignment="Bottom"
                                       Margin="10,0,10,0" Foreground="{StaticResource BrushTextMuted}" />

                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource SectionLabel}" ctrl:Tracking.Text="NEW" />
                                <TextBlock Text="{Binding LastChange.Next}" Style="{StaticResource CellMono}"
                                           FontWeight="SemiBold" Margin="0,4,0,0"
                                           Foreground="{Binding LastChange.NextBrushKey, Converter={StaticResource ResBrush}}" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Style="{StaticResource SectionLabel}" ctrl:Tracking.Text="AUTHORIZED BY" />
                            <TextBlock Text="{Binding LastChange.Authoriser}" Style="{StaticResource Cell}"
                                       Margin="0,4,0,0" />
                        </StackPanel>

                        <Border Style="{StaticResource Divider}" Margin="0,2,0,12" />

                        <Grid>
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionLabel}" ctrl:Tracking.Text="STATUS" />
                                <TextBlock Text="{Binding LastChange.StatusLabel}" FontSize="13" FontWeight="SemiBold"
                                           Margin="0,4,0,0" Foreground="{StaticResource BrushCompleted}" />
                            </StackPanel>
                            <TextBlock Text="{Binding LastChange.TimeDisplay}" Style="{StaticResource CellMono}"
                                       HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Placeholder before any change -->
                <Border Style="{StaticResource Panel}"
                        Visibility="{Binding HasReceipt, Converter={StaticResource BoolToVisInv}}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionLabel}" ctrl:Tracking.Text="POLICY RECEIPT" />
                        <TextBlock Style="{StaticResource Muted}" FontSize="10.5" TextWrapping="Wrap" Margin="0,10,0,0"
                                   Text="Toggle a cell in the matrix. The confirmation receipt for that change appears here, and the change is written to the audit trail." />
                    </StackPanel>
                </Border>

                <!-- Role defaults -->
                <Border Style="{StaticResource Panel}" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionLabel}" ctrl:Tracking.Text="REAPPLY ROLE DEFAULTS" />
                        <TextBlock Style="{StaticResource Muted}" FontSize="10" Margin="0,6,0,0" TextWrapping="Wrap"
                                   Text="Resets an account's grants to the standard set for its role." />

                        <ItemsControl ItemsSource="{Binding Columns}" Margin="0,12,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource DataRow}" Padding="10,7">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding DisplayName}" Style="{StaticResource Cell}" />
                                                <TextBlock Text="{Binding RoleLabel}" Style="{StaticResource CellDim}" />
                                            </StackPanel>
                                            <Button Grid.Column="1" Style="{StaticResource BtnSmallGhost}"
                                                    Content="RESET"
                                                    Command="{Binding DataContext.ApplyDefaultsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource InsetPanel}" Padding="14,12" Margin="0,14,0,0">
                    <TextBlock Style="{StaticResource Muted}" FontSize="10" TextWrapping="Wrap"
                               Text="This is NEXUS's own authorization system. It governs what accounts can do inside this application and does not grant or revoke access on any external system." />
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
