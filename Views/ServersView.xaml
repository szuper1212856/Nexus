<UserControl x:Class="NEXUS.Views.ServersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:NEXUS.Controls">

    <Grid Margin="28,0,20,24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360" />
            <ColumnDefinition Width="*" MinWidth="440" />
        </Grid.ColumnDefinitions>

        <!-- ================= SERVER LIST ================= -->
        <Border Grid.Column="0" Style="{StaticResource Panel}" Margin="0,0,14,0" VerticalAlignment="Top">
            <StackPanel>
                <Grid>
                    <TextBlock Style="{StaticResource SectionLabel}" ctrl:Tracking.Text="SERVERS" />
                    <Button HorizontalAlignment="Right" Style="{StaticResource BtnSmallGhost}" Content="REFRESH"
                            Command="{Binding RefreshCommand}" />
                </Grid>

                <ItemsControl ItemsSource="{Binding Servers}" Margin="0,14,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <RadioButton GroupName="ServerRow" Style="{StaticResource RowButton}"
                                         Command="{Binding DataContext.SelectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                         CommandParameter="{Binding}">
                                <RadioButton.IsChecked>
                                    <MultiBinding Converter="{StaticResource SameObj}" Mode="OneWay">
                                        <Binding />
                                        <Binding Path="DataContext.Selected"
                                                 RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                    </MultiBinding>
                                </RadioButton.IsChecked>

                                <StackPanel>
                                    <Grid>
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                                     Fill="{Binding StatusBrushKey, Converter={StaticResource ResBrush}}" />
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource Cell}"
                                                       FontWeight="SemiBold" Margin="9,0,0,0" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding UptimeDisplay}" Style="{StaticResource CellMono}"
                                                   HorizontalAlignment="Right" />
                                    </Grid>

                                    <TextBlock Style="{StaticResource CellDim}" Margin="17,4,0,0">
                                        <Run Text="{Binding Host, Mode=OneWay}" /><Run Text=" &#183; " /><Run Text="{Binding ServiceSummary, Mode=OneWay}" />
                                    </TextBlock>

                                    <!-- CPU / MEM / DISK meters -->
                                    <Grid Margin="17,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                            <TextBlock Text="{Binding CpuPercent}" Style="{StaticResource CellMono}"
                                                       FontSize="10" />
                                            <Grid Margin="0,4,0,0" Height="5">
                                                <Border Style="{StaticResource MeterTrack}" />
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="{Binding CpuLoad, Converter={StaticResource FracStar}}" />
                                                        <ColumnDefinition Width="{Binding CpuLoad, Converter={StaticResource FracStarRem}}" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Height="5" CornerRadius="3"
                                                            Background="{StaticResource BrushAccent}" />
                                                </Grid>
                                            </Grid>
                                            <TextBlock Style="{StaticResource MetricLabel}" FontSize="8"
                                                       ctrl:Tracking.Text="CPU" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                            <TextBlock Text="{Binding MemoryPercent}" Style="{StaticResource CellMono}"
                                                       FontSize="10" />
                                            <Grid Margin="0,4,0,0" Height="5">
                                                <Border Style="{StaticResource MeterTrack}" />
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="{Binding MemoryLoad, Converter={StaticResource FracStar}}" />
                                                        <ColumnDefinition Width="{Binding MemoryLoad, Converter={StaticResource FracStarRem}}" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Height="5" CornerRadius="3"
                                                            Background="{StaticResource BrushLow}" />
                                                </Grid>
                                            </Grid>
                                            <TextBlock Style="{StaticResource MetricLabel}" FontSize="8"
                                                       ctrl:Tracking.Text="MEM" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="{Binding StoragePercent}" Style="{StaticResource CellMono}"
                                                       FontSize="10" />
                                            <Grid Margin="0,4,0,0" Height="5">
                                                <Border Style="{StaticResource MeterTrack}" />
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="{Binding StorageLoad, Converter={StaticResource FracStar}}" />
                                                        <ColumnDefinition Width="{Binding StorageLoad, Converter={StaticResource FracStarRem}}" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Height="5" CornerRadius="3"
                                                            Background="{StaticResource BrushNormal}" />
                                                </Grid>
                                            </Grid>
                                            <TextBlock Style="{StaticResource MetricLabel}" FontSize="8"
                                                       ctrl:Tracking.Text="DISK" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </RadioButton>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Style="{StaticResource Divider}" Margin="0,14,0,12" />

                <UniformGrid Columns="2">
                    <StackPanel>
                        <TextBlock Text="{Binding RunningServices}" Style="{StaticResource Mono}"
                                   FontSize="18" FontWeight="SemiBold"
                                   Foreground="{StaticResource BrushCompleted}" />
                        <TextBlock Style="{StaticResource MetricLabel}" ctrl:Tracking.Text="SERVICES RUNNING" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="{Binding TotalServices}" Style="{StaticResource Mono}"
                                   FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Style="{StaticResource MetricLabel}" ctrl:Tracking.Text="REGISTERED" />
                    </StackPanel>
                </UniformGrid>
            </StackPanel>
        </Border>

        <!-- ================= SERVER DETAIL ================= -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0"
                      Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
            <StackPanel>

                <Border Style="{StaticResource Panel}">
                    <StackPanel>
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="42" Height="42" CornerRadius="9"
                                        Background="{StaticResource BrushPanelAlt}" BorderThickness="1"
                                        BorderBrush="{Binding Selected.StatusBrushKey, Converter={StaticResource ResBrush}}">
                                    <TextBlock Text="{ctrl:Glyph Server}" FontFamily="{StaticResource FontIcon}" FontSize="18"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="{Binding Selected.StatusBrushKey, Converter={StaticResource ResBrush}}" />
                                </Border>
                                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Selected.Name}" FontSize="15" FontWeight="SemiBold" />
                                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                        <TextBlock Text="{Binding Selected.StatusLabel}" FontSize="10"
                                                   FontWeight="SemiBold"
                                                   Foreground="{Binding Selected.StatusBrushKey, Converter={StaticResource ResBrush}}" />
                                        <TextBlock Text="{Binding Selected.Host}" Style="{StaticResource CellDim}"
                                                   Margin="10,0,0,0" />
                                        <Border Style="{StaticResource Pill}" Margin="10,0,0,0"
                                                BorderBrush="{StaticResource BrushBorder}">
                                            <TextBlock Style="{StaticResource PillText}"
                                                       Text="{Binding Selected.IntegrationLabel}"
                                                       Foreground="{StaticResource BrushTextDim}" />
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>

                            <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Style="{StaticResource BtnSmall}" Content="TOGGLE POWER"
                                    Command="{Binding ToggleServerCommand}" />
                        </Grid>

                        <Border Style="{StaticResource Divider}" Margin="0,16,0,12" />

                        <UniformGrid Columns="4">
                            <StackPanel>
                                <TextBlock Text="{Binding Selected.CpuPercent}" Style="{StaticResource MetricValue}"
                                           FontSize="18" />
                                <TextBlock Style="{StaticResource MetricLabel}" ctrl:Tracking.Text="CPU" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="{Binding Selected.MemoryPercent}" Style="{StaticResource MetricValue}"
                                           FontSize="18" />
                                <TextBlock Style="{StaticResource MetricLabel}" ctrl:Tracking.Text="MEMORY" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="{Binding Selected.StoragePercent}" Style="{StaticResource MetricValue}"
                                           FontSize="18" />
                                <TextBlock Style="{StaticResource MetricLabel}" ctrl:Tracking.Text="STORAGE" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="{Binding Selected.UptimeDisplay}" Style="{StaticResource MetricValue}"
                                           FontSize="18" />
                                <TextBlock Style="{StaticResource MetricLabel}" ctrl:Tracking.Text="UPTIME" />
                            </StackPanel>
                        </UniformGrid>

                        <TextBlock Text="{Binding Selected.OperatingSystem}" Style="{StaticResource Muted}"
                                   FontSize="10.5" Margin="0,14,0,0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>

                <!-- Services -->
                <Border Style="{StaticResource Panel}" Margin="0,14,0,0">
                    <StackPanel>
                        <Grid>
                            <TextBlock Style="{StaticResource SectionLabel}" ctrl:Tracking.Text="SERVICES" />
                            <TextBlock Text="{Binding Selected.ServiceSummary}" Style="{StaticResource Caption}"
                                       FontWeight="SemiBold" HorizontalAlignment="Right" />
                        </Grid>

                        <Border Style="{StaticResource TableHeaderBar}" Margin="0,12,0,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Style="{StaticResource ColHead}" ctrl:Tracking.Text="SERVICE" />
                                <TextBlock Grid.Column="1" Style="{StaticResource ColHead}" ctrl:Tracking.Text="PORT" />
                                <TextBlock Grid.Column="2" Style="{StaticResource ColHead}" ctrl:Tracking.Text="STATE" />
                                <TextBlock Grid.Column="3" Style="{StaticResource ColHead}" ctrl:Tracking.Text="UPTIME" />
                                <TextBlock Grid.Column="4" Style="{StaticResource ColHead}" ctrl:Tracking.Text="ACTIONS" />
                            </Grid>
                        </Border>

                        <ItemsControl ItemsSource="{Binding Selected.Services}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource DataRow}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="80" />
                                                <ColumnDefinition Width="100" />
                                                <ColumnDefinition Width="90" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource Cell}"
                                                           FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Description}" Style="{StaticResource CellDim}" />
                                            </StackPanel>

                                            <TextBlock Grid.Column="1" Text="{Binding PortDisplay}"
                                                       Style="{StaticResource CellMono}" />

                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Ellipse Width="7" Height="7" VerticalAlignment="Center"
                                                         Fill="{Binding StateBrushKey, Converter={StaticResource ResBrush}}" />
                                                <TextBlock Text="{Binding StateLabel}" FontSize="9.5" Margin="7,0,0,0"
                                                           FontWeight="SemiBold" VerticalAlignment="Center"
                                                           Foreground="{Binding StateBrushKey, Converter={StaticResource ResBrush}}" />
                                            </StackPanel>

                                            <TextBlock Grid.Column="3" Text="{Binding UptimeDisplay}"
                                                       Style="{StaticResource CellMono}" />

                                            <StackPanel Grid.Column="4" Orientation="Horizontal">
                                                <Button Style="{StaticResource BtnIcon}" Width="26" Height="26"
                                                        Content="{ctrl:Glyph Play}" ToolTip="Start"
                                                        Command="{Binding DataContext.StartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" />
                                                <Button Style="{StaticResource BtnIcon}" Width="26" Height="26"
                                                        Content="{ctrl:Glyph Stop}" ToolTip="Stop"
                                                        Command="{Binding DataContext.StopCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" />
                                                <Button Style="{StaticResource BtnIcon}" Width="26" Height="26"
                                                        Content="{ctrl:Glyph Refresh}" ToolTip="Restart"
                                                        Command="{Binding DataContext.RestartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border Style="{StaticResource InsetPanel}" Padding="12,10" Margin="0,12,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{ctrl:Glyph Info}" FontFamily="{StaticResource FontIcon}" FontSize="11"
                                           VerticalAlignment="Top" Margin="0,1,0,0"
                                           Foreground="{StaticResource BrushLow}" />
                                <TextBlock Style="{StaticResource Muted}" FontSize="10.5" TextWrapping="Wrap"
                                           Margin="10,0,0,0" MaxWidth="520"
                                           Text="Service actions update the NEXUS record. Wiring a server to a real backend is done by registering an integration, at which point these controls drive the actual service." />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
