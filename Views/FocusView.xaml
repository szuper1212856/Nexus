<UserControl x:Class="NEXUS.Views.FocusView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:NEXUS.Controls">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,0,20,24">
        <Grid Margin="0,0,8,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="440" />
                <ColumnDefinition Width="360" />
            </Grid.ColumnDefinitions>

            <!-- ================= TIMER ================= -->
            <Border Grid.Column="0" Style="{StaticResource Panel}" Padding="28" Margin="0,0,14,0"
                    VerticalAlignment="Top">
                <StackPanel>
                    <Grid>
                        <TextBlock Style="{StaticResource SectionLabel}" ctrl:Tracking.Text="FOCUS SESSION" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Ellipse Width="6" Height="6" VerticalAlignment="Center"
                                     Fill="{StaticResource BrushAccent}" />
                            <TextBlock Text="{Binding Timer.StateLabel}" FontSize="10" FontWeight="SemiBold"
                                       Margin="7,0,0,0" VerticalAlignment="Center"
                                       Foreground="{StaticResource BrushAccent}" />
                        </StackPanel>
                    </Grid>

                    <Border Style="{StaticResource Divider}" Margin="0,14,0,0" />

                    <!-- Task name -->
                    <TextBlock Text="{Binding Timer.TaskTitle}" FontSize="16" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" Margin="0,14,0,0"
                               HorizontalAlignment="Center" TextAlignment="Center" />

                    <!-- Ring + countdown -->
                    <Grid Width="248" Height="248" Margin="0,20,0,0">
                        <ctrl:RingGauge Value="{Binding Timer.Fraction}" RingThickness="10"
                                        TrackBrush="{StaticResource BrushBorderSoft}"
                                        ValueBrush="{StaticResource BrushAccent}" />
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Timer.TimeDisplay}" Style="{StaticResource Mono}"
                                       FontSize="52" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock Style="{StaticResource Muted}" FontSize="10" HorizontalAlignment="Center"
                                       Margin="0,4,0,0">
                                <Run Text="{Binding Timer.PlannedMinutes, Mode=OneWay}" /><Run Text=" MIN SESSION" />
                            </TextBlock>
                        </StackPanel>
                    </Grid>

                    <!-- Duration chips (only meaningful before the session starts) -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,22,0,0"
                                IsEnabled="{Binding Timer.IsIdle}">
                        <ToggleButton Style="{StaticResource Chip}" Content="15 MIN"
                                      IsChecked="{Binding DurationKey, Converter={StaticResource EqBool}, ConverterParameter=15, Mode=OneWay}"
                                      Command="{Binding SetDurationCommand}" CommandParameter="15" />
                        <ToggleButton Style="{StaticResource Chip}" Content="25 MIN"
                                      IsChecked="{Binding DurationKey, Converter={StaticResource EqBool}, ConverterParameter=25, Mode=OneWay}"
                                      Command="{Binding SetDurationCommand}" CommandParameter="25" />
                        <ToggleButton Style="{StaticResource Chip}" Content="45 MIN"
                                      IsChecked="{Binding DurationKey, Converter={StaticResource EqBool}, ConverterParameter=45, Mode=OneWay}"
                                      Command="{Binding SetDurationCommand}" CommandParameter="45" />
                        <ToggleButton Style="{StaticResource Chip}" Content="60 MIN"
                                      IsChecked="{Binding DurationKey, Converter={StaticResource EqBool}, ConverterParameter=60, Mode=OneWay}"
                                      Command="{Binding SetDurationCommand}" CommandParameter="60" />
                    </StackPanel>

                    <!-- Controls -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,22,0,0">
                        <Button Style="{StaticResource BtnPrimary}" Padding="26,11" Margin="0,0,10,0"
                                Command="{Binding StartCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{ctrl:Glyph Play}" FontFamily="{StaticResource FontIcon}" FontSize="11"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="START" Margin="8,0,0,0" FontWeight="SemiBold" FontSize="11"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource Btn}" Padding="22,11" Margin="0,0,10,0"
                                Content="PAUSE" Command="{Binding PauseCommand}" />

                        <Button Style="{StaticResource Btn}" Padding="22,11" Margin="0,0,10,0"
                                Content="COMPLETE" Command="{Binding CompleteCommand}"
                                ToolTip="End the session and mark the task complete" />

                        <Button Style="{StaticResource BtnDanger}" Padding="22,11"
                                Content="EXIT" Command="{Binding ExitCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ================= SIDE PANEL ================= -->
            <StackPanel Grid.Column="1">

                <!-- Task selector -->
                <Border Style="{StaticResource Panel}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionLabel}" ctrl:Tracking.Text="TARGET TASK" />
                        <ComboBox Style="{StaticResource Combo}" Margin="0,12,0,0"
                                  IsEnabled="{Binding Timer.IsIdle}"
                                  ItemsSource="{Binding Candidates}"
                                  SelectedItem="{Binding SelectedTask}"
                                  DisplayMemberPath="Title" />
                        <TextBlock Text="Pick the item this session is dedicated to, or leave the highest-priority task selected."
                                   Style="{StaticResource Muted}" FontSize="10.5" TextWrapping="Wrap"
                                   Margin="0,10,0,0" />

                        <Border Style="{StaticResource Divider}" Margin="0,14,0,12" />

                        <Grid>
                            <StackPanel>
                                <TextBlock Text="{Binding SessionsToday}" Style="{StaticResource Mono}"
                                           FontSize="20" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource MetricLabel}" ctrl:Tracking.Text="SESSIONS TODAY" />
                            </StackPanel>
                            <StackPanel HorizontalAlignment="Right">
                                <TextBlock Text="{Binding FocusedTimeToday}" Style="{StaticResource Mono}"
                                           FontSize="20" FontWeight="SemiBold"
                                           HorizontalAlignment="Right"
                                           Foreground="{StaticResource BrushAccent}" />
                                <TextBlock Style="{StaticResource MetricLabel}" HorizontalAlignment="Right"
                                           ctrl:Tracking.Text="FOCUSED TIME" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- History -->
                <Border Style="{StaticResource Panel}" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionLabel}" ctrl:Tracking.Text="RECENT SESSIONS" />

                        <ItemsControl ItemsSource="{Binding History}" Margin="0,12,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Width="3" CornerRadius="2" Margin="0,2,10,2"
                                                Background="{StaticResource BrushLow}" />

                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding TaskTitle}" FontSize="11.5"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Style="{StaticResource Muted}" FontSize="9.5" Margin="0,2,0,0">
                                                <Run Text="{Binding PlannedMinutes, Mode=OneWay}" /><Run Text=" MIN PLANNED" />
                                            </TextBlock>
                                        </StackPanel>

                                        <TextBlock Grid.Column="2" Style="{StaticResource Mono}" FontSize="10"
                                                   VerticalAlignment="Center"
                                                   Foreground="{StaticResource BrushTextMuted}"
                                                   Text="{Binding StartedUtc, StringFormat=HH:mm}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="No sessions recorded yet." Style="{StaticResource Muted}"
                                   Margin="0,8,0,0"
                                   Visibility="{Binding History.Count, Converter={StaticResource CountToVisInv}}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
